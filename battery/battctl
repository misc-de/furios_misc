COLORS = {"green": "#2ec27e", "amber": "#e5a50a", "red": "#e01b24"}
BUCKETS = ("green", "amber", "red")

# The two halves of the icon, and they say two different things.
#
#   the shell and the bolt      how fast the battery is moving  -> `color`
#   the level inside            how full it is                  -> the palette
#
# The level carries class="success" in the Adwaita SVG and is drawn from
# GTK's symbolic palette, which nothing on this phone sets - it came out
# white inside a red battery. All three palette names get the same colour,
# because below 20 % the fill is "warning" and "error" instead, and the
# level is meant to be one colour whichever file phosh picked.
#
# Either declaration may be absent, and that is how "no colour" is said:
# a rule without `color` leaves the shell in the panel's own foreground, a
# rule without the palette leaves the level in it. Naming a white would be
# guessing at a foreground we cannot read.
# phosh's percentage, made to hold its place without showing anything.
#
# Three declarations, and each is load-bearing:
#   color        the text goes, the widget stays
#   font-size    its own text no longer decides how wide it is, so 9 %, 48 %
#                and 100 % all reserve the same room and the icons beside it
#                cannot shift under our clock
#   min-width    and this is how much room. It has to hold OUR text, not the
#                percentage's: at 41 the slot fits "04:38" at 16 px with a
#                15 px gap to the battery icon. Measured on the device on
#                16.9.2026 by stepping the value and reading the icon
#                positions out of a screenshot - at 29, which was right for
#                13 px text, the clock touched the icon.
#
# Why at all: this is the only way to have the time where the percentage was.
# Switching the percentage off with its gsettings key frees the space and
# phosh immediately moves the battery icon into it - measured: the icon goes
# from 613..631 to 666..683, and there is nothing to its right but phosh's
# own 36 px of padding.
RULE_PERCENT = ("phosh-battery-info label {\n"
                "  color: transparent;\n"
                "  font-size: 1px;\n"
                "  min-width: 41px;\n"
                "}\n")
RULE_COLOR = "  color: %s;\n"
RULE_PALETTE = "  -gtk-icon-palette: %s;\n"
RULE = "phosh-battery-info image {\n%s}\n"

# Which of the two shapes the power colour lands on.
#
#   "c"  charging, and the icon has a bolt of its own: the BOLT takes the
#        power colour and the frame stays in the colour of the bar.
#   "d"  everything else: there is no bolt to colour, so the frame takes it.
#
# Two rules rather than one, because CSS cannot ask which icon is on screen.
# The daemon knows, and the theme name carries the answer.
KINDS = ("c", "d")


def css_rule(power=None, level=None, kind="d", colors=None, percent=False):
    """The stylesheet for one combination, or "" when there is nothing to
    say.

    The palette carries two statements: the filling (success, and error for
    the low-level icons that draw it that way) and, on a charging icon of
    ours, the bolt (warning). Absent declarations are how "no colour" is
    said - naming a white would be guessing at a foreground we cannot read.

    `percent` adds the rule that empties phosh's percentage without freeing
    its place. It is the one part of this stylesheet that is not a colour,
    and it is here because a theme is the only thing on this phone that can
    reach into the shell at runtime.
    """
    farben = colors or COLORS
    leer = RULE_PERCENT if percent else ""
    body = ""
    if power and kind == "d":
        body += RULE_COLOR % farben[power]
    parts = []
    if level:
        # success and error, because the low-level icons draw their filling
        # with the second one.
        parts.append("success %s, error %s" % (farben[level], farben[level]))
    if power and kind == "c":
        parts.append("warning %s" % farben[power])
    if parts:
        # Only the halves that have something to say: a palette naming all
        # three would paint the filling in the colour of the bolt whenever
        # the level is fine - seen on the phone, an orange filling in a
        # battery that was 84 % full.
        body += RULE_PALETTE % ", ".join(parts)
    return (RULE % body if body else "") + leer


# The colours belong in the fingerprint as much as the rule does. GTK3
# restyles when the theme NAME changes, not when the file underneath it
# does - so recolouring a bucket while that bucket is the one on screen
# would rewrite a stylesheet nobody re-reads, and the old colour would sit
# there until the power happened to move to another bucket and back.
# Folding COLORS in means a new colour is a new name, which restyles at
# once and lets stale_themes() carry the old generation off the disk.
TOKEN = hashlib.sha1((RULE + RULE_COLOR + RULE_PALETTE + RULE_PERCENT
                      + "".join(KINDS)
                      + "".join("%s=%s" % kv for kv in sorted(COLORS.items()))
                      ).encode()).hexdigest()[:4]

# Matches a name of ours - the current shape "<base>-batt<token>-<power>-
# <level>" and the ones older versions wrote, which is what lets an upgrade
# recognise its own leftovers instead of taking them for somebody's theme.
MARK = re.compile(r"^(?P<base>.+)-batt[0-9a-f]{0,8}"
                  r"-(?P<power>none|%s)(?:-(?P<level>none|%s))?"
                  r"(?:-(?P<kind>[cd]))?(?:-(?P<percent>p))?$"
                  % ("|".join(BUCKETS), "|".join(BUCKETS)))

