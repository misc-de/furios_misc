"""Colour phosh's battery icon by how fast the battery is actually moving.

The phone shows a percentage and a lightning bolt, and both look the same
whether 1 watt or 6 are going in. That is the one number worth seeing at a
glance - a bad cable, a laptop port or a charger that has quietly renegotiated
all look like "charging" and cost hours.

So: green while it is going in fast, amber in the middle, red when it is
barely moving. Optionally the same on battery, where the meaning is reversed -
green is a phone that is drawing little.

How the colour gets there, because the obvious way does not work:

  phosh is GTK3 and its battery icon is the CSS node `phosh-battery-info`, so
  one line of CSS colours it. But GTK3 reads ~/.config/gtk-3.0/gtk.css exactly
  once, at program start, and never looks at it again - a colour that changes
  would need the shell restarted every time, which on this phone is the one
  thing not to do.

  What GTK3 does re-read at runtime is the THEME. Changing
  org.gnome.desktop.interface gtk-theme restyles every running GTK3 app,
  phosh included, within a second. So this writes three themes that are the
  user's own theme plus one line - `phosh-battery-info image { color: … }` -
  and switches between them by name.

That is also the cost, and it is worth knowing before turning this on: every
change restyles all GTK3 apps for a moment, and the theme setting shows one of
our names while it is active. It happens when the colour changes, not
continuously - a handful of times per charge.

Nothing here needs root. It reads two files in /sys, writes ~/.themes, and
sets one gsettings key.
"""

import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import time

SYSFS = os.environ.get("FURIOS_BATTERY_SYSFS", "/sys/class/power_supply/battery")
CONFIG = os.environ.get(
    "FURIOS_BATTERY_CONFIG",
    os.path.join(os.environ.get("XDG_CONFIG_HOME",
                                os.path.expanduser("~/.config")),
                 "furios-battery", "config.json"))
THEMES = os.environ.get("FURIOS_BATTERY_THEMES",
                        os.path.expanduser("~/.themes"))
# Where a theme we did not write may live. Ours always go to THEMES.
THEME_DIRS = [
    THEMES,
    os.path.join(os.environ.get("XDG_DATA_HOME",
                                os.path.expanduser("~/.local/share")), "themes"),
    "/usr/local/share/themes",
    "/usr/share/themes",
]

SETTING = "org.gnome.desktop.interface gtk-theme"

COLORS = {"green": "#2ec27e", "amber": "#ff7800", "red": "#e01b24"}
BUCKETS = ("green", "amber", "red")

# The two halves of the icon, and they say two different things.
#
#   the shell and the bolt      how fast the battery is moving  -> `color`
#   the level inside            how full it is                  -> the palette
#
# The level carries class="success" in the Adwaita SVG and is drawn from
# GTK's symbolic palette, which nothing on this phone sets - it came out
# white inside a red battery. All three palette names get the same colour,
# because below 20 % the fill is "warning" and "error" instead, and the
# level is meant to be one colour whichever file phosh picked.
#
# Either declaration may be absent, and that is how "no colour" is said:
# a rule without `color` leaves the shell in the panel's own foreground, a
# rule without the palette leaves the level in it. Naming a white would be
# guessing at a foreground we cannot read.
RULE_COLOR = "  color: %s;\n"
RULE_PALETTE = ("  -gtk-icon-palette: success %(farbe)s, warning %(farbe)s,"
                " error %(farbe)s;\n")
RULE = "phosh-battery-info image {\n%s}\n"


def css_rule(power=None, level=None, colors=None):
    """The stylesheet for one combination, or "" when there is nothing to
    say."""
    farben = colors or COLORS
    inhalt = ""
    if power:
        inhalt += RULE_COLOR % farben[power]
    if level:
        inhalt += RULE_PALETTE % {"farbe": farben[level]}
    return RULE % inhalt if inhalt else ""


# Four characters of the rule, carried in the theme name.
#
# Not decoration: GTK3 caches a named theme for the lifetime of the process,
# by name, with no second look at the file. Change the rule and keep the
# name, and phosh keeps serving the version it parsed at boot - the file on
# disk is right, the icon is wrong, and nothing says why until the next
# reboot. A name that changes with the rule is what makes an upgrade visible
# the same minute.
TOKEN = hashlib.sha1((RULE + RULE_COLOR + RULE_PALETTE).encode()).hexdigest()[:4]

# Matches a name of ours - the current shape "<base>-batt<token>-<power>-
# <level>" and the ones older versions wrote, which is what lets an upgrade
# recognise its own leftovers instead of taking them for somebody's theme.
MARK = re.compile(r"^(?P<base>.+)-batt[0-9a-f]{0,8}"
                  r"-(?P<power>none|%s)(?:-(?P<level>none|%s))?$"
                  % ("|".join(BUCKETS), "|".join(BUCKETS)))

DEFAULTS = {
    # Colour while charging. On by default - it is what this is for.
    "charging": True,
    # Colour on battery too, with the meaning reversed: green is a phone that
    # is drawing little. Off by default, because a colour that is on all day
    # stops being a signal.
    "discharging": False,
    # Charging: watts into the battery. Defaults are deliberately provisional
    # and meant to be corrected once a full charge has been watched - see
    # FINDINGS.md. This phone negotiates 12.7 W over USB-PD but was seen
    # taking 5.9 W at its best.
    "charge_green_w": 7.0,
    "charge_amber_w": 3.0,
    # On battery the scale is not three colours but two, and white is the
    # normal state: a phone doing what a phone does says nothing, and only an
    # unusual drain speaks up. Green would be a colour on all day, which is
    # no signal at all.
    #
    # PROVISIONAL, and the numbers that most need measuring - see FINDINGS.md
    # and `battctl watch`. What matters is the drain with the SCREEN ON,
    # because that is the only time anybody sees this icon.
    "drain_amber_w": 3.0,
    "drain_red_w": 5.0,
    # The filling says something else entirely: how full the battery is.
    # Above level_amber_pct it stays in the panel's own colour, below
    # level_red_pct it is red.
    "level": True,
    "level_amber_pct": 60.0,
    "level_red_pct": 15.0,
    # Two points of hysteresis, so a percentage sitting on 60 and stepping
    # to 61 and back does not restyle every app twice a minute.
    "level_hysteresis_pct": 2.0,
    # How far past a threshold the power has to go before the colour follows.
    # A tenth: the instantaneous current swings by a quarter of an amp from
    # one reading to the next, and without this the icon would flicker
    # between two colours on the noise alone.
    "hysteresis": 0.1,
    # And how long a colour stays put at the very least. Each change restyles
    # every GTK3 app, so this is the one number that decides what this costs
    # the rest of the phone.
    "dwell_s": 45,
    # How long a reading counts towards the median.
    "window_s": 60,
}

# Where the icons live, and the device UPower publishes them for.
ICON_DIRS = ["/usr/share/icons", "/usr/local/share/icons",
             os.path.expanduser("~/.local/share/icons"),
             os.path.expanduser("~/.icons")]
UPOWER_DEV = "/org/freedesktop/UPower/devices/battery_battery"

# How urgent a colour is, for the case where only one of them fits.
RANK = {None: 0, "green": 1, "amber": 2, "red": 3}


def find_icon(name):
    """The file behind an icon name, or None."""
    if not name:
        return None
    for wurzel in ICON_DIRS:
        for teil in ("symbolic/status", "scalable/status", "symbolic/legacy",
                     "scalable/legacy"):
            for theme in ("Adwaita", "hicolor", ""):
                pfad = os.path.join(wurzel, theme, teil, name + ".svg")
                if os.path.isfile(pfad):
                    return pfad
    return None


def icon_is_split(name, charging=False):
    """Can this icon's filling be coloured apart from its shell?

    Only where the SVG draws it as its own path. In Adwaita that is true of
    the charging and plugged-in icons and NOT of the twelve plain ones an
    ordinary discharge uses: those are a single path, so `color` paints the
    whole battery and the palette paints nothing. Measured, not assumed -
    the file is read and asked whether it has a class at all.
    """
    pfad = find_icon(name)
    if pfad:
        try:
            with open(pfad) as fh:
                return "class=" in fh.read()
        except OSError:
            pass
    if name:
        return "-charging" in name or "-plugged-in" in name
    return bool(charging)


def upower_icon():
    """The icon name UPower publishes.

    Asked because it is what phosh actually shows, and because the two
    sources disagree: seen on 15.9.2026 with sysfs saying "Charging" at
    0.6 W while UPower said "discharging" at 0 W and the shell drew the
    plain icon. Which icon is on screen decides whether there are two
    halves to colour, so it has to come from the same place as the icon.
    """
    # One test seam, like the settings file: the tests must not depend on
    # what this phone's UPower happens to say while they run.
    erzwungen = os.environ.get("FURIOS_BATTERY_ICON")
    if erzwungen is not None:
        return erzwungen or None
    try:
        aus = subprocess.run(["upower", "-i", UPOWER_DEV],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    for zeile in aus.stdout.splitlines():
        if "icon-name" in zeile:
            return zeile.split(":", 1)[1].strip().strip("'")
    return None


def icon_says_charging(name):
    """Does the icon on screen carry the bolt?"""
    return "-charging" in (name or "")


def sources_agree(mess, icon=None):
    """Do the kernel and UPower tell the same story?

    They do not always. On 15.9.2026 sysfs said "Charging" at 1.8 W while
    UPower said "discharging" at 0 W, and phosh - which follows UPower -
    drew the icon without a bolt. Painting a charging colour onto an icon
    that says the phone is on battery is worse than painting nothing: the
    colour would be answering a question the picture does not ask.

    So when they disagree, the shell gets no colour at all. The filling
    still does - how full the battery is, both sources agree on.
    """
    if mess is None or icon is None:
        return True
    return icon_says_charging(icon) == bool(mess["charging"])


def merge_colours(power, level):
    """One colour for an icon that has only one shape: the more urgent of
    the two. Neither statement is dropped silently - what is left is "there
    is something worth noticing", which is what a single shape can say."""
    return power if RANK[power] >= RANK[level] else level


# A plausibility ceiling, not a limit. current_now × voltage_now is the whole
# measurement, and a driver that reports milliamps where the class says
# microamps would produce a thousandfold number and a permanently green icon.
# Better to say nothing than to say something wrong.
MAX_PLAUSIBLE_W = 60.0


# --------------------------------------------------------------- Konfiguration

def load_config(path=None):
    """Defaults, overlaid with whatever is on disk.

    A broken or half-written file is not an error worth stopping for: the
    colour is cosmetic, the defaults are sane, and a daemon that refuses to
    start because a json file has a stray comma would be the bigger fault.
    """
    cfg = dict(DEFAULTS)
    try:
        with open(path or CONFIG) as fh:
            gelesen = json.load(fh)
        if isinstance(gelesen, dict):
            for key, val in gelesen.items():
                if key in DEFAULTS and isinstance(val, type(DEFAULTS[key])):
                    cfg[key] = val
                elif (key in DEFAULTS and isinstance(DEFAULTS[key], float)
                        and isinstance(val, int) and not isinstance(val, bool)):
                    # 3 where 3.0 was meant. json does not know the difference
                    # and a person editing the file by hand should not have to.
                    cfg[key] = float(val)
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg, path=None):
    ziel = path or CONFIG
    os.makedirs(os.path.dirname(ziel), exist_ok=True)
    # Written beside the target and renamed: a phone that loses power halfway
    # through this should find the old file, not half of the new one.
    tmp = ziel + ".neu"
    with open(tmp, "w") as fh:
        json.dump({k: cfg[k] for k in sorted(cfg)}, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, ziel)


# ------------------------------------------------------------------- Messung

def _read(name, base=None):
    try:
        with open(os.path.join(base or SYSFS, name)) as fh:
            return fh.read().strip()
    except OSError:
        return None


def read_battery(base=None):
    """What the battery is doing right now, or None if it cannot be read.

    Sign is deliberately thrown away. Some drivers count discharge negative,
    some do not, and this one has only ever been seen charging - `status` is
    the reliable statement of direction, so the current is only ever asked how
    MUCH, never which way.
    """
    status = _read("status", base)
    strom = _read("current_now", base)
    spannung = _read("voltage_now", base)
    if status is None or strom is None or spannung is None:
        return None
    try:
        ampere = abs(int(strom)) / 1e6
        volt = int(spannung) / 1e6
    except ValueError:
        return None
    try:
        # Missing or unreadable is None, not 0: a phone whose capacity
        # cannot be read must not have its icon painted "nearly empty".
        prozent = float(_read("capacity", base))
    except (TypeError, ValueError):
        prozent = None
    watt = ampere * volt
    return {
        "status": status,
        "percent": prozent,
        "ampere": ampere,
        "volt": volt,
        "watt": watt,
        "charging": status == "Charging",
        # "Full" and "Not charging" are neither: the cable is in and nothing
        # is moving. Colouring that red would be a fault report for a phone
        # that is simply done.
        "moving": status in ("Charging", "Discharging"),
        "plausible": watt <= MAX_PLAUSIBLE_W,
    }


def median(werte):
    s = sorted(werte)
    n = len(s)
    if not n:
        return None
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def bucket_for(watt, charging, cfg, current=None):
    """Which of the three colours this wattage is, given the one showing now.

    `current` is what makes it hysteresis rather than a threshold: leaving a
    colour costs a tenth more than entering it did, so a reading that sits on
    a boundary and wobbles stays where it is.
    """
    h = cfg["hysteresis"]
    if charging:
        gruen, gelb = cfg["charge_green_w"], cfg["charge_amber_w"]
        if current == "green":
            gruen *= 1 - h
        elif current == "amber":
            gruen *= 1 + h
            gelb *= 1 - h
        elif current == "red":
            gelb *= 1 + h
        if watt >= gruen:
            return "green"
        return "amber" if watt >= gelb else "red"
    # On battery: white until the drain is unusual, then amber, then red.
    # No green - the ordinary case is the one that should say nothing.
    rot, gelb = cfg["drain_red_w"], cfg["drain_amber_w"]
    if current == "red":
        rot *= 1 - h
    elif current == "amber":
        rot *= 1 + h
        gelb *= 1 - h
    else:
        gelb *= 1 + h
    if watt >= rot:
        return "red"
    return "amber" if watt >= gelb else None


def level_for(percent, cfg, current=None):
    """The colour of the filling: how full, not how fast.

    None means "leave it in the panel's own colour" - which is what a
    healthy battery should look like, the same as every other icon up there.
    """
    if percent is None or not cfg["level"]:
        return None
    h = cfg["level_hysteresis_pct"]
    gelb, rot = cfg["level_amber_pct"], cfg["level_red_pct"]
    # Leaving a colour costs the two points that entering it did not, so a
    # percentage stepping across 60 and back does not restyle twice.
    if current == "red":
        rot += h
    elif current == "amber":
        gelb += h
        rot -= h
    if percent < rot:
        return "red"
    return "amber" if percent < gelb else None


def wanted_level(mess, cfg, current=None):
    if mess is None:
        return None
    return level_for(mess.get("percent"), cfg, current)


def wanted_bucket(mess, cfg, current=None, icon=None):
    """The colour of the shell, or None for "leave it alone"."""
    if mess is None or not mess["plausible"] or not mess["moving"]:
        return None
    if not sources_agree(mess, icon):
        return None
    if mess["charging"] and not cfg["charging"]:
        return None
    if not mess["charging"] and not cfg["discharging"]:
        return None
    return bucket_for(mess["watt"], mess["charging"], cfg, current)


# -------------------------------------------------------------------- Themes

def base_name(name):
    """The user's own theme behind a name that may be one of ours."""
    treffer = MARK.match(name or "")
    return treffer.group("base") if treffer else name


def colours_of(name):
    """The pair (power, level) a theme name stands for, ("", "") if it is
    not one of ours. Either half may be None, meaning "not coloured"."""
    treffer = MARK.match(name or "")
    if not treffer:
        return ("", "")
    weiche = lambda wert: None if wert in (None, "none") else wert  # noqa: E731
    return (weiche(treffer.group("power")), weiche(treffer.group("level")))


def theme_name(base, power=None, level=None):
    return "%s-batt%s-%s-%s" % (base, TOKEN, power or "none", level or "none")


def base_css(base):
    """Where the user's theme keeps its GTK3 stylesheets.

    Returns (light, dark); dark is None when the theme has none. That case
    matters: GTK3 picks gtk-dark.css when it exists and the session prefers
    dark, so writing one for a theme that has none would make dark mode use
    the light stylesheet - the colour would work and the whole phone would
    change appearance.
    """
    for ordner in THEME_DIRS:
        gtk3 = os.path.join(ordner, base, "gtk-3.0")
        hell = os.path.join(gtk3, "gtk.css")
        if os.path.isfile(hell):
            dunkel = os.path.join(gtk3, "gtk-dark.css")
            return hell, (dunkel if os.path.isfile(dunkel) else None)
    # Adwaita and HighContrast have no files: GTK3 carries them as resources.
    # Anything else with no stylesheet on disk is a theme we cannot build on,
    # and the caller says so rather than writing a theme that renders the
    # phone unstyled.
    eingebaut = {
        "Adwaita": ("Adwaita", "gtk-contained.css", "gtk-contained-dark.css"),
        "Adwaita-dark": ("Adwaita", "gtk-contained-dark.css", None),
        "HighContrast": ("HighContrast", "gtk-contained.css",
                         "gtk-contained-inverse.css"),
    }
    if base in eingebaut:
        ordner, hell, dunkel = eingebaut[base]
        pfad = "resource:///org/gtk/libgtk/theme/" + ordner + "/"
        return pfad + hell, (pfad + dunkel if dunkel else None)
    return None, None


def _import(ziel):
    # An @import keeps the original file the original file: everything it
    # loads by relative path - assets, the libadwaita part, the lot - still
    # resolves against where IT lives, not where our copy does.
    if ziel.startswith("resource:"):
        return '@import url("%s");\n' % ziel
    return '@import url("file://%s");\n' % ziel


def write_theme(base, power=None, level=None, themes_dir=None, colors=None):
    """Write the theme for one combination. Returns its name, or None.

    Written when it is needed rather than all twelve up front: most phones
    only ever see a handful of the combinations, and twelve directories in
    ~/.themes is twelve entries in every theme chooser on the phone.

    Rewritten every time even when it exists, because the user's theme may
    have been updated by a package - a stale copy of its name with a fresh
    stylesheet underneath is the kind of difference nobody would look for.
    """
    regel = css_rule(power, level, colors)
    if not regel:
        return None                       # nothing to say - that is the base
    hell, dunkel = base_css(base)
    if hell is None:
        return None
    wurzel = themes_dir or THEMES
    name = theme_name(base, power, level)
    gtk3 = os.path.join(wurzel, name, "gtk-3.0")
    os.makedirs(gtk3, exist_ok=True)
    kopf = ("/* Written by battctl (furios_misc). Deleted by "
            "`battctl restore`. */\n")
    with open(os.path.join(gtk3, "gtk.css"), "w") as fh:
        fh.write(_import(hell) + kopf + regel)
    dunkelziel = os.path.join(gtk3, "gtk-dark.css")
    if dunkel:
        with open(dunkelziel, "w") as fh:
            fh.write(_import(dunkel) + kopf + regel)
    elif os.path.exists(dunkelziel):
        # The base theme lost its dark sheet between two runs.
        os.unlink(dunkelziel)
    return name


def can_theme(base):
    """Can anything be built on this theme at all?

    Asked before the daemon starts: a base with no GTK3 stylesheet is the
    one failure that leaves every other reading looking healthy while the
    icon never changes colour.
    """
    return base_css(base)[0] is not None


def stale_themes(themes_dir=None):
    """Our themes from an older rule. Returns the names."""
    wurzel = themes_dir or THEMES
    try:
        eintraege = sorted(os.listdir(wurzel))
    except OSError:
        return []
    alt = []
    for name in eintraege:
        if base_name(name) == name:
            continue                      # not one of ours
        if ("-batt%s-" % TOKEN) in name:
            continue                      # this generation
        alt.append(name)
    return alt


def remove_themes(themes_dir=None, nur=None):
    """Take our themes off the disk. Returns how many went.

    `nur` is a list of names - used to clear out what an older version of
    the rule left behind without touching this generation, so a phone does
    not collect directories per upgrade.
    """
    wurzel = themes_dir or THEMES
    weg = 0
    try:
        eintraege = sorted(os.listdir(wurzel))
    except OSError:
        return 0
    for name in eintraege:
        if nur is not None and name not in nur:
            continue
        if base_name(name) == name:
            continue                      # not one of ours
        pfad = os.path.join(wurzel, name)
        marker = os.path.join(pfad, "gtk-3.0", "gtk.css")
        try:
            with open(marker) as fh:
                if "battctl" not in fh.read(200):
                    continue              # same name, somebody else's file
        except OSError:
            continue
        for ordner, _, dateien in os.walk(pfad, topdown=False):
            for datei in dateien:
                os.unlink(os.path.join(ordner, datei))
            os.rmdir(ordner)
        weg += 1
    return weg


# ------------------------------------------------------- die Einstellung selbst

class Setting:
    """The gtk-theme key, through `gsettings`.

    The command line rather than Gio.Settings on purpose: this has to work
    from a test and from a terminal over ssh, and a schema object bound to a
    session bus does neither without ceremony. One process per change, and
    changes are rare by design.
    """

    def __init__(self, datei=None):
        # Tests point this at a file instead of dconf. Nothing else does.
        self.datei = datei or os.environ.get("FURIOS_BATTERY_SETTING_FILE")

    def get(self):
        if self.datei:
            try:
                with open(self.datei) as fh:
                    return fh.read().strip()
            except OSError:
                return ""
        try:
            aus = subprocess.run(["gsettings", "get"] + SETTING.split(),
                                 capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            return ""
        return aus.stdout.strip().strip("'")

    def set(self, name):
        if self.datei:
            with open(self.datei, "w") as fh:
                fh.write(name + "\n")
            return True
        try:
            aus = subprocess.run(["gsettings", "set"] + SETTING.split() + [name],
                                 capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            return False
        return aus.returncode == 0


# -------------------------------------------------------------------- Zustand

def describe(cfg=None, setting=None, base=None):
    """Everything both front ends show, in one dict."""
    cfg = cfg or load_config()
    setting = setting or Setting()
    mess = read_battery()
    jetzt = setting.get()
    basis = base or base_name(jetzt)
    zeigt, zeigt_stand = colours_of(jetzt)
    stand = wanted_level(mess, cfg, zeigt_stand)
    symbol = upower_icon()
    einig = sources_agree(mess, symbol)
    bucket = wanted_bucket(mess, cfg, zeigt, symbol)
    geteilt = icon_is_split(symbol, (mess or {}).get("charging"))
    if not geteilt:
        bucket = stand = merge_colours(bucket, stand)
    hell, _ = base_css(basis)
    return {
        "state": (mess or {}).get("status", "unknown"),
        "watt": round((mess or {}).get("watt", 0.0), 2),
        "ampere": round((mess or {}).get("ampere", 0.0), 3),
        "volt": round((mess or {}).get("volt", 0.0), 3),
        "percent": (mess or {}).get("percent"),
        "readable": mess is not None,
        "plausible": (mess or {}).get("plausible", False),
        "bucket": bucket or "none",
        "showing": zeigt or "none",
        # The filling, which says something else: how full, not how fast.
        "level_bucket": stand or "none",
        "level_showing": zeigt_stand or "none",
        # Whether this icon has two halves to colour at all.
        "icon": symbol or "?",
        "split_icon": geteilt,
        # False while the kernel and UPower disagree about the direction.
        "sources_agree": einig,
        "theme": jetzt,
        "base_theme": basis,
        # A theme we cannot build on is the one failure that leaves everything
        # else looking healthy, so it is stated rather than implied.
        "can_theme": hell is not None,
        "config": cfg,
    }


def cmd_status(argv):
    zustand = describe()
    if "--json" in argv:
        print(json.dumps(zustand, indent=2, sort_keys=True))
        return 0 if zustand["readable"] else 1
    cfg = zustand["config"]
    print("state:        %s" % zustand["state"])
    if zustand["readable"]:
        print("power:        %.2f W (%.3f A at %.3f V)"
              % (zustand["watt"], zustand["ampere"], zustand["volt"]))
    else:
        print("power:        not readable (%s)" % SYSFS)
    print("shell:        %s (would be %s)"
          % (zustand["showing"], zustand["bucket"]))
    print("filling:      %s (would be %s) at %s %%"
          % (zustand["level_showing"], zustand["level_bucket"],
             "?" if zustand["percent"] is None else int(zustand["percent"])))
    print("icon:         %s%s" % (zustand["icon"],
          "" if zustand["split_icon"]
          else " - one shape, so both halves take the same colour"))
    if not zustand["sources_agree"]:
        print("             ! the kernel says %s and UPower draws the other "
              "one - no colour for the shell until they agree"
              % zustand["state"].lower())
    print("base theme:   %s" % zustand["base_theme"])
    print("theme now:    %s" % zustand["theme"])
    if not zustand["can_theme"]:
        print("             ! no GTK3 stylesheet found for that theme - "
              "nothing can be coloured")
    print("charging:     %s (green from %.1f W, amber from %.1f W)"
          % ("on" if cfg["charging"] else "off",
             cfg["charge_green_w"], cfg["charge_amber_w"]))
    print("discharging:  %s (white below %.1f W, amber from there, red "
          "from %.1f W)"
          % ("on" if cfg["discharging"] else "off",
             cfg["drain_amber_w"], cfg["drain_red_w"]))
    print("filling:      %s (plain above %d %%, amber below, red below %d %%)"
          % ("on" if cfg["level"] else "off",
             int(cfg["level_amber_pct"]), int(cfg["level_red_pct"])))
    return 0 if zustand["readable"] else 1


# Which config keys `battctl config` will take, and how to read the value.
SCHALTER = ("charging", "discharging", "level")
ZAHLEN = ("charge_green_w", "charge_amber_w", "drain_amber_w", "drain_red_w",
          "level_amber_pct", "level_red_pct", "level_hysteresis_pct",
          "dwell_s", "window_s", "hysteresis")


def cmd_config(argv):
    cfg = load_config()
    if not argv:
        for key in sorted(cfg):
            print("%s: %s" % (key, cfg[key]))
        return 0
    if len(argv) != 2:
        print("Usage: battctl config <key> <value>", file=sys.stderr)
        return 2
    key, wert = argv
    key = key.replace("-", "_")
    if key in SCHALTER:
        if wert not in ("on", "off"):
            print("%s takes on or off." % key, file=sys.stderr)
            return 2
        cfg[key] = wert == "on"
    elif key in ZAHLEN:
        try:
            zahl = float(wert)
        except ValueError:
            print("%s takes a number." % key, file=sys.stderr)
            return 2
        if zahl <= 0:
            print("%s must be greater than zero." % key, file=sys.stderr)
            return 2
        cfg[key] = int(zahl) if isinstance(DEFAULTS[key], int) else zahl
    else:
        print("Unknown setting: %s" % key, file=sys.stderr)
        print("Known: %s" % " ".join(sorted(SCHALTER + ZAHLEN)), file=sys.stderr)
        return 2
    # Thresholds that cross would make one colour unreachable, and the reason
    # would be two numbers in a file nobody opens.
    if cfg["charge_green_w"] <= cfg["charge_amber_w"]:
        print("charge_green_w must be above charge_amber_w.", file=sys.stderr)
        return 2
    if cfg["drain_amber_w"] >= cfg["drain_red_w"]:
        print("drain_amber_w must be below drain_red_w.", file=sys.stderr)
        return 2
    if cfg["level_red_pct"] >= cfg["level_amber_pct"]:
        print("level_red_pct must be below level_amber_pct.", file=sys.stderr)
        return 2
    save_config(cfg)
    print("%s: %s" % (key, cfg[key]))
    return 0


def cmd_reset(_argv):
    """Put the user's own theme back. Idempotent, and safe to call twice."""
    setting = Setting()
    jetzt = setting.get()
    basis = base_name(jetzt)
    if jetzt == basis:
        return 0
    return 0 if setting.set(basis) else 1


def cmd_restore(_argv):
    """Back to how the phone shipped: own theme, no colour themes, no config.

    The service is not stopped here - it is the app's switch and systemd's
    business, and a tool that disables the unit somebody just enabled would
    be fighting its own front end. The daemon notices the themes are gone and
    writes them again, which is why the app stops the service first.
    """
    cmd_reset([])
    weg = remove_themes()
    try:
        os.unlink(CONFIG)
    except OSError:
        pass
    print("Own theme restored, %d colour theme(s) removed." % weg)
    return 0


# --------------------------------------------------------------------- Daemon

class Daemon:
    """The loop: read, smooth, decide, and only then touch the setting."""

    def __init__(self, cfg=None, setting=None, jetzt=None):
        self.cfg = cfg or load_config()
        self.setting = setting or Setting()
        self.samples = []                 # (Zeitpunkt, Watt, laedt)
        # (Huelle, Fuellung) - die Namen der Farben, nicht des Themes
        self.showing = (None, None)
        self.last_change = 0.0
        self.last_good = 0.0              # wann zuletzt etwas Brauchbares kam
        self.cfg_stamp = self._stamp()
        # The icon name UPower publishes, kept up to date by whoever drives
        # the loop. It decides whether there are two halves to colour: the
        # plain discharge icons are a single path.
        self.icon = None
        self.base = base_name(jetzt if jetzt is not None else self.setting.get())

    @staticmethod
    def _stamp(pfad=None):
        try:
            zustand = os.stat(pfad or CONFIG)
        except OSError:
            return None
        return (zustand.st_mtime_ns, zustand.st_size)

    def reload(self):
        """Take a changed config without being restarted.

        The app switches "also on battery" by writing that file, and a daemon
        that only read it at startup would leave the switch looking broken
        until the next boot - the setting would be saved, and nothing would
        happen. Checked by timestamp, so the ordinary tick costs one stat().
        """
        stempel = self._stamp()
        if stempel == self.cfg_stamp:
            return False
        self.cfg_stamp = stempel
        self.cfg = load_config()
        return True

    def ensure_theme(self, power, level):
        """The theme for one pair, written if it is not there yet."""
        return write_theme(self.base, power, level)

    def adopt(self, name):
        """Somebody changed the theme while we were running.

        If it is not one of ours, it is a decision, and everything we generated
        is now built on the wrong base. Rebuild against the new one and carry
        the colour over.
        """
        if base_name(name) == self.base:
            return False
        self.base = base_name(name)
        self.showing = (None, None)
        return True

    def sample(self, now=None, mess=None):
        now = time.time() if now is None else now
        mess = read_battery() if mess is None else mess
        if mess is None or not mess["plausible"]:
            return None
        self.samples.append((now, mess["watt"], mess["charging"]))
        grenze = now - self.cfg["window_s"]
        self.samples = [s for s in self.samples if s[0] >= grenze]
        return mess

    def decide(self, mess, now=None):
        """The colour to show, from the median of the window - not from the
        last reading. current_now swings by a quarter of an amp between two
        reads of the same steady charge."""
        now = time.time() if now is None else now
        if mess is None or not mess["moving"]:
            return None
        # A direction that keeps changing is not a direction. With a worn
        # USB port the phone flips between charging and discharging every
        # few minutes (measured on 15.9.2026: nine times in 26 minutes),
        # and following that would restyle every GTK3 app about once a
        # minute for something the cable is doing, not the battery. So the
        # shell says nothing until a whole window agrees.
        if len({c for (_, _, c) in self.samples}) > 1:
            return None
        gleich = [w for (_, w, c) in self.samples if c == mess["charging"]]
        mitte = median(gleich) if gleich else mess["watt"]
        glatt = dict(mess)
        glatt["watt"] = mitte
        return wanted_bucket(glatt, self.cfg, self.showing[0], self.icon)

    def apply(self, paar, now=None):
        """Set the theme for (shell colour, filling colour).

        Returns True when the setting was written. One pair, one theme: the
        two halves of the icon live in the same stylesheet, so a change to
        either is one switch, not two.
        """
        now = time.time() if now is None else now
        paar = tuple(paar)
        if paar == self.showing:
            return False
        if (self.showing != (None, None)
                and now - self.last_change < self.cfg["dwell_s"]):
            return False
        if paar == (None, None):
            ziel = self.base
        else:
            ziel = self.ensure_theme(*paar)
            if ziel is None:
                return False
        if not self.setting.set(ziel):
            return False
        self.showing = paar
        self.last_change = now
        return True

    def tick(self, now=None, mess=None):
        now = time.time() if now is None else now
        self.reload()
        jetzt = self.setting.get()
        if jetzt and self.adopt(jetzt):
            pass
        elif jetzt and base_name(jetzt) == self.base:
            # Someone (a crash of ours, a second instance) left a colour on
            # that we are not tracking. Adopt it so hysteresis and dwell start
            # from what is on screen.
            zeigt = colours_of(jetzt)
            if zeigt != ("", "") and self.showing == (None, None):
                self.showing = zeigt
        gemessen = self.sample(now, mess)
        if gemessen is None:
            # Nothing readable this time. One failed read is not a reason to
            # restyle every app on the phone, so the colour stays - but not
            # for ever: a colour nothing can justify any more is worse than
            # no colour, so once a whole window has gone by without a
            # measurement it goes.
            if (self.showing != (None, None)
                    and now - self.last_good > self.cfg["window_s"]):
                return self.apply((None, None), now)
            return False
        self.last_good = now
        huelle = self.decide(gemessen, now)
        fuellung = wanted_level(gemessen, self.cfg, self.showing[1])
        if not icon_is_split(self.icon, gemessen["charging"]):
            # One shape, one colour. Saying both would mean the filling
            # silently overwriting the shell, or the other way round -
            # instead the more urgent of the two speaks for the whole icon.
            huelle = fuellung = merge_colours(huelle, fuellung)
        return self.apply((huelle, fuellung), now)


def cmd_daemon(_argv):
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    class GioSetting(Setting):
        """The same key, read and written inside this process.

        The command line is right for a one-shot; for the daemon it is a
        fork, an exec and a schema parse per tick, which measured 47 ms a
        minute - not much, and all of it for a value we can hold. Same
        class, so everything above it is unchanged.
        """

        def __init__(self):
            super().__init__()
            self.datei = None
            schema, schluessel = SETTING.split()
            self.gio = Gio.Settings.new(schema)
            self.schluessel = schluessel

        def get(self):
            return self.gio.get_string(self.schluessel)

        def set(self, name):
            gesetzt = self.gio.set_string(self.schluessel, name)
            # Written through before we call it done: the process may be
            # asked to stop in the next moment, and a theme that only
            # reaches dconf after we are gone is a theme nobody set.
            Gio.Settings.sync()
            return gesetzt

    daemon = Daemon(setting=GioSetting())
    # Leftovers from an older rule, before anything new is written: the
    # names differ, so nothing in use is touched.
    veraltet = stale_themes()
    if veraltet:
        remove_themes(nur=veraltet)
    if not can_theme(daemon.base):
        print("No GTK3 stylesheet found for theme %r - nothing to colour."
              % daemon.base, file=sys.stderr)
        return 1
    print("colouring the battery icon on top of %s" % daemon.base, flush=True)

    schleife = GLib.MainLoop()
    proxy = None

    def aufwachen(*_):
        try:
            if proxy is not None:
                # Cached, so this costs nothing: the property arrives with
                # the signal that woke us.
                name = proxy.get_cached_property("IconName")
                daemon.icon = name.get_string() if name else None
            if daemon.tick():
                print("shell %s, filling %s -> %s"
                      % (daemon.showing[0] or "plain",
                         daemon.showing[1] or "plain",
                         daemon.setting.get()), flush=True)
        except Exception as fehler:                  # noqa: BLE001
            # A cosmetic daemon must not die of a surprise in one reading.
            print("tick failed: %r" % (fehler,), file=sys.stderr, flush=True)
        return True

    def beenden(*_):
        # The theme goes back before we do. A green icon left behind on a
        # phone whose daemon is gone would be a lie that outlives it.
        daemon.apply((None, None), now=time.time() + daemon.cfg["dwell_s"])
        schleife.quit()
        return True

    # UPower is the clock. It already polls the battery for every other
    # program on the phone and emits a signal when a value moves, so riding
    # along costs no wake-ups of our own - and the alternative, a timer of
    # ours, is exactly the kind of thing that turned out to cost half a
    # percent of a core in a sibling project.
    #
    # The proxy is KEPT, not left to the garbage collector: a subscription
    # whose connection is dropped expires silently - no error, no log line, a
    # healthy-looking service that never measures anything. That has happened
    # here before.
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        proxy = Gio.DBusProxy.new_sync(
            bus, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None,
            "org.freedesktop.UPower",
            "/org/freedesktop/UPower/devices/battery_battery",
            "org.freedesktop.UPower.Device", None)
        proxy.connect("g-properties-changed", aufwachen)
    except GLib.Error as fehler:
        print("no UPower to listen to (%s) - falling back to the timer alone"
              % fehler.message, file=sys.stderr, flush=True)
        proxy = None

    # The safety net, and the whole answer when there is no UPower: a slow
    # timer. It also covers the case the comment above warns about - if the
    # subscription ever dies, the colour keeps following, just later.
    GLib.timeout_add_seconds(120, aufwachen)
    # GLibUnix where it exists, GLib where it does not: pygobject moved
    # unix_signal_add and warns twice into the journal on every start
    # otherwise - two lines that would be in every log for ever, saying
    # nothing about this phone.
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError):
        signal_add = GLib.unix_signal_add
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, beenden)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, beenden)

    aufwachen()
    schleife.run()
    # Referenced after the loop so nothing can decide the proxy was unused.
    del proxy
    return 0


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def quantil(werte, anteil):
    if not werte:
        return None
    s = sorted(werte)
    # Round half UP, not round(): Python rounds 4.5 to 4, and a quantile
    # that quietly picks the lower neighbour at every .5 is a surprise in a
    # number somebody sets a threshold from.
    i = min(len(s) - 1, max(0, int(anteil * (len(s) - 1) + 0.5)))
    return s[i]


def cmd_watch(argv):
    """Write down what the phone actually draws, so the thresholds are
    measured rather than guessed.

    The number that matters is the drain with the SCREEN ON: this icon is
    only ever seen by somebody looking at the screen, so "normal" means
    normal while in use, not the 0.2 W of a phone lying on a table. The rows
    carry that state so the two can be told apart afterwards.
    """
    sekunden, abstand, ziel = 3600.0, 5.0, None
    rest = list(argv)
    while rest:
        wort = rest.pop(0)
        if wort in ("--csv", "-o") and rest:
            ziel = rest.pop(0)
        elif wort in ("--interval", "-i") and rest:
            abstand = float(rest.pop(0))
        else:
            try:
                sekunden = float(wort)
            except ValueError:
                print("Usage: battctl watch [seconds] [--interval s] "
                      "[--csv file]", file=sys.stderr)
                return 2

    aus = open(ziel, "a") if ziel else None
    kopf = "time,state,watt,percent,screen"
    print(kopf, flush=True)
    if aus and aus.tell() == 0:
        aus.write(kopf + "\n")

    proben = {"Charging": [], "Discharging": []}
    richtungen = []
    ende = time.time() + sekunden
    try:
        while time.time() < ende:
            mess = read_battery()
            if mess and mess["plausible"]:
                zeile = "%s,%s,%.3f,%s,%s" % (
                    now_iso(), mess["status"],
                    mess["watt"], _read("capacity") or "?", _screen_on())
                print(zeile, flush=True)
                if aus:
                    aus.write(zeile + "\n")
                    aus.flush()
                proben.setdefault(mess["status"], []).append(mess["watt"])
                richtungen.append((now_iso(), mess["status"]))
            time.sleep(abstand)
    except KeyboardInterrupt:
        print()
    finally:
        if aus:
            aus.close()

    # How often the direction changed during the run. A worn USB port
    # turns the charging half of a measurement into noise, and a calibration
    # run should say so rather than hand over a median of it.
    wechsel = 0
    vorher = None
    for zeitpunkt, zustand in richtungen:
        if vorher is not None and zustand != vorher:
            wechsel += 1
        vorher = zustand
    if wechsel:
        print("\ndirection changed %d times during the run - a charging "
              "figure from this is not a baseline" % wechsel)

    for zustand in ("Discharging", "Charging"):
        werte = proben.get(zustand) or []
        if not werte:
            continue
        print("\n%s: %d readings" % (zustand, len(werte)))
        for name, anteil in (("median", 0.5), ("p90", 0.9), ("p98", 0.98)):
            print("  %-7s %5.2f W" % (name, quantil(werte, anteil)))
        print("  %-7s %5.2f W" % ("max", max(werte)))
        if zustand == "Discharging":
            print("  A starting point: amber at p90, red at p98 - so that "
                  "the ordinary tenth speaks and the rest stays white.")
    return 0


def _screen_on():
    """Whether the display is lit, as well as it can be told here.

    logind's IdleHint said "no" with the screen off, and the backlight LED
    kept its last brightness, so neither is the answer on its own. What is
    reliable is that a compositor with a dark panel still answers a frame
    grab - but running grim once a sample is absurd. So this reports the
    backlight value and lets whoever reads the log decide; "?" where there
    is none.
    """
    for pfad in ("/sys/class/backlight/panel0-backlight/brightness",
                 "/sys/class/leds/lcd-backlight/brightness"):
        try:
            with open(pfad) as fh:
                return fh.read().strip()
        except OSError:
            continue
    return "?"


USAGE = """battctl - colour phosh's battery icon by charge power

  battctl status [--json]     what the battery is doing and which colour shows
  battctl config              every setting and its value
  battctl config <key> <val>  charging|discharging on|off, or a threshold in W
  battctl watch [s] [--csv f] write down what the phone draws, to measure
                              the thresholds instead of guessing them
  battctl daemon              the loop; this is what the service runs
  battctl reset               put the user's own theme back
  battctl restore             reset, plus remove the colour themes and config

The service is what turns this on and off:
  systemctl --user enable --now furios-battery-color.service
"""


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    befehl, rest = argv[0], argv[1:]
    for name, fn in (("status", cmd_status), ("config", cmd_config),
                     ("daemon", cmd_daemon), ("reset", cmd_reset),
                     ("restore", cmd_restore), ("watch", cmd_watch)):
        if befehl == name:
            return fn(rest)
    print("Unknown command: %s" % befehl, file=sys.stderr)
    print(USAGE, end="", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
