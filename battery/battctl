# Where the icons live. The user's directories FIRST, which is the order
# GTK searches in - a file of ours in ~/.local/share/icons/Adwaita shadows
# the one in /usr/share for this user and for nobody else.
ICON_DIRS = [os.path.expanduser("~/.icons"),
             os.path.expanduser("~/.local/share/icons"),
             "/usr/local/share/icons", "/usr/share/icons"]
# Our own icon theme, and where the originals come from.
#
# A theme of our own rather than files dropped into ~/.local/share/icons/
# Adwaita, which shadows the system theme for this user. That was the first
# attempt and it has a trap: GTK caches an icon lookup, and once a file it
# had found disappears the shell draws the broken-image placeholder and
# never recovers - measured on 15.9.2026, and there is no way to make phosh
# re-read without restarting it. Switching the icon-theme setting always
# rebuilds, so the theme is both how the icons arrive and how they leave.
# The name carries a fingerprint of what we generate, for the same reason
# the GTK theme does: GTK caches an icon theme by name, so adding a file to
# a theme that is already in use is invisible until the setting changes.
# Measured: the bolt icons arrived and the shell went on drawing Adwaita's.
ICON_THEME_BASE = "furios-battery"
ICON_SETTING = "org.gnome.desktop.interface icon-theme"
ICON_BASE = os.path.join(
    os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
    "icons")
ICON_SOURCE = "/usr/share/icons/Adwaita/symbolic/status"
INDEX_THEME = """[Icon Theme]
Name=%(name)s
Comment=%(inherits)s, plus battery icons whose filling can be coloured alone
Inherits=%(inherits)s,hicolor
Directories=symbolic/status

[symbolic/status]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status
"""
ICON_MARK = "<!-- battctl (furios_misc): filling split off so it can be "
ICON_MARK_FULL = (ICON_MARK + "coloured on its own. Remove with "
                  "`battctl restore`. -->")
ICON_ANY = re.compile(r"^%s(?:-[0-9a-f]{4})?$" % re.escape(ICON_THEME_BASE))
# The same for the bolt of the charging icons.
BOLT_MARK = ("<!-- battctl (furios_misc): bolt split off so it can be "
             "coloured apart from the frame. -->")
# Four characters of what we generate, carried in the theme name.
ICON_TOKEN = hashlib.sha1((ICON_MARK_FULL + BOLT_MARK
                           + 'class="success" d="m 5 %d h 6 v %d h -6 z"'
                           + 'class="warning"').encode()).hexdigest()[:4]
ICON_THEME = "%s-%s" % (ICON_THEME_BASE, ICON_TOKEN)
UPOWER_DEV = "/org/freedesktop/UPower/devices/battery_battery"

# How urgent a colour is, for the case where only one of them fits.
RANK = {None: 0, "green": 1, "amber": 2, "red": 3}


def find_icon(name):
    """The file behind an icon name, or None."""
    if not name:
        return None
    for root_dir in ICON_DIRS:
        for teil in ("symbolic/status", "scalable/status", "symbolic/legacy",
                     "scalable/legacy"):
            for theme in (ICON_THEME, "Adwaita", "hicolor", ""):
                path = os.path.join(root_dir, theme, teil, name + ".svg")
                if os.path.isfile(path):
                    return path
    return None


def phosh_icon(percent, charging):
    """The icon name phosh builds for this reading.

    Not UPower's `icon-name`: phosh makes its own out of
    "battery-level-%d-symbolic" and the level rounded to tens, and the two
    differ - UPower says battery-full-symbolic where phosh draws
    battery-level-90-symbolic, and those two files are not even built the
    same way. Asking the wrong one was giving the wrong answer about
    whether the icon has two halves.
    """
    level_step = 100 if percent is None else max(0, min(100, int(round(percent / 10.0)) * 10))
    return "battery-level-%d-%ssymbolic" % (level_step, "charging-" if charging else "")


def split_icon_svg(source, level):
    """The source SVG with a filling of its own laid over it.

    Adwaita draws the discharge battery as a single path: outline, cut-out
    and the level inside, all in one. Nothing in CSS can reach the level
    alone. So an identical rectangle goes on top, carrying class="success",
    and from then on the palette colours it - the geometry is the icon's
    own (x 5, width 6, bottom at 13, one unit per 12.5 %), verified against
    the originals at 100, 90, 50 and 30 %.

    Returns None where there is nothing to do: an icon that already has a
    class, or an empty battery with no filling to colour.
    """
    try:
        with open(source) as fh:
            text = fh.read()
    except OSError:
        return None
    if "class=" in text or ICON_MARK in text:
        return None
    height = int(round(8 * level / 100.0))
    if height <= 0:
        return None
    rect = ('<path class="success" d="m 5 %d h 6 v %d h -6 z" '
                'fill="#33d17a"/>' % (13 - height, height))
    return text.replace("</svg>", ICON_MARK_FULL + "\n" + rect + "\n</svg>")


def icon_theme_dir(root_dir=None):
    return os.path.join(root_dir or ICON_BASE, ICON_THEME)


def icon_base_theme(root_dir=None):
    """The theme ours inherits from - the user's own, read back out of the
    index we wrote. That is where it is remembered, so a crash cannot lose
    it and a person can read it."""
    path = os.path.join(icon_theme_dir(root_dir), "index.theme")
    try:
        with open(path) as fh:
            for line in fh:
                if line.startswith("Inherits="):
                    return line.split("=", 1)[1].strip().split(",")[0]
    except OSError:
        pass
    return None


def bolt_icon_svg(source_path):
    """The charging icon with a bolt of its own, so it can be coloured
    apart from the frame.

    Adwaita draws frame and bolt as two subpaths of ONE path, and `color`
    reaches both or neither. The bolt is the second subpath; the first ends
    with `z`, so the current point is back at the path's own start (7,0)
    and the bolt's relative "m 6 8" is the absolute (13,8). Checked against
    all ten charging icons: identical structure in every one.

    Rather than cutting the subpath out - which would mean rewriting
    coordinates - an identical copy goes ON TOP, carrying class="warning".
    The palette colours it from there.
    """
    try:
        with open(source_path) as fh:
            text = fh.read()
    except OSError:
        return None
    if BOLT_MARK in text:
        return None
    pfade = re.findall(r'<path[^>]*d="([^"]+)"', text)
    if not pfade:
        return None
    fg = pfade[-1]
    parts = [t.strip() for t in re.split(r"(?=[Mm]\s)", fg.strip()) if t.strip()]
    if len(parts) < 2:
        return None
    start = re.match(r"m\s+(-?[\d.]+)\s+(-?[\d.]+)", parts[0])
    bolt = re.match(r"m\s+(-?[\d.]+)\s+(-?[\d.]+)(.*)$", parts[1], re.S)
    # Only where the assumption holds: the frame closes, so the bolt's
    # relative start counts from the path's own beginning. Anywhere else
    # this would put the bolt in the wrong place, and no colour at all is
    # better than a magenta smear next to the battery.
    if not start or not bolt or not parts[0].rstrip().endswith("z"):
        return None
    x = float(start.group(1)) + float(bolt.group(1))
    y = float(start.group(2)) + float(bolt.group(2))
    absolut = "M %g %g%s" % (x, y, bolt.group(3))
    return text.replace("</svg>", '%s\n<path class="warning" d="%s" '
                        'fill="#33d17a"/>\n</svg>' % (BOLT_MARK, absolut))


def write_icon_theme(base="Adwaita", root_dir=None, source=None):
    """Write our icon theme: an index that inherits the user's own, and the
    discharge icons with a filling of their own. Returns the icon names."""
    source = source or ICON_SOURCE
    folder = icon_theme_dir(root_dir)
    target = os.path.join(folder, "symbolic", "status")
    written = []
    def lege_ab(name, new_text):
        if new_text is None:
            return
        os.makedirs(target, exist_ok=True)
        path = os.path.join(target, name)
        try:
            with open(path) as fh:
                if fh.read() == new_text:
                    written.append(name)
                    return
        except OSError:
            pass
        with open(path, "w") as fh:
            fh.write(new_text)
        written.append(name)

    for level in range(0, 101, 10):
        name = "battery-level-%d-symbolic.svg" % level
        lege_ab(name, split_icon_svg(os.path.join(source, name), level))
        # And the charging icons, for the bolt.
        name = "battery-level-%d-charging-symbolic.svg" % level
        lege_ab(name, bolt_icon_svg(os.path.join(source, name)))
    if not written:
        return []
    with open(os.path.join(folder, "index.theme"), "w") as fh:
        fh.write(INDEX_THEME % {"name": ICON_THEME, "inherits": base})
    return written


def stale_icon_themes(root_dir=None):
    """Icon themes of ours from an older generation. Returns the names."""
    root = root_dir or ICON_BASE
    try:
        entries = sorted(os.listdir(root))
    except OSError:
        return []
    return [n for n in entries if ICON_ANY.match(n) and n != ICON_THEME]


def remove_icon_theme(root_dir=None, name=None):
    """Take our icon theme off the disk. Returns how many files went.

    Only ours, and only if it is ours: a directory of that name without our
    marker in it was put there by somebody else and stays.
    """
    folder = (os.path.join(root_dir or ICON_BASE, name) if name
              else icon_theme_dir(root_dir))
    target = os.path.join(folder, "symbolic", "status")
    gone = 0
    try:
        entries = sorted(os.listdir(target))
    except OSError:
        return 0
    for name in entries:
        path = os.path.join(target, name)
        try:
            with open(path) as fh:
                inhalt = fh.read()
            if ICON_MARK not in inhalt and BOLT_MARK not in inhalt:
                continue
        except OSError:
            continue
        os.unlink(path)
        gone += 1
    if gone:
        for rest in (target, os.path.dirname(target), folder):
            try:
                os.rmdir(rest)
            except OSError:
                # index.theme is still in there, and it goes with the rest.
                index = os.path.join(rest, "index.theme")
                if os.path.exists(index):
                    os.unlink(index)
                    try:
                        os.rmdir(rest)
                    except OSError:
                        pass
    return gone


def icon_has_bolt(name):
    """Does the icon on screen carry a bolt of its own to colour?

    Only ours do - Adwaita draws frame and bolt in one path. Without one
    the power colour has to go on the frame, or nothing would be coloured
    at all while charging.
    """
    path = find_icon(name)
    if not path:
        return False
    try:
        with open(path) as fh:
            return BOLT_MARK in fh.read()
    except OSError:
        return False


def icon_is_split(name, charging=False):
    """Can this icon's filling be coloured apart from its shell?

    Only where the SVG draws it as its own path. In Adwaita that is true of
    the charging and plugged-in icons and NOT of the twelve plain ones an
    ordinary discharge uses: those are a single path, so `color` paints the
    whole battery and the palette paints nothing. Measured, not assumed -
    the file is read and asked whether it has a class at all.
    """
    path = find_icon(name)
    if path:
        try:
            with open(path) as fh:
                return "class=" in fh.read()
        except OSError:
            pass
    if name:
        return "-charging" in name or "-plugged-in" in name
    return bool(charging)


def upower_icon():
    """The icon name UPower publishes.

    Asked because it is what phosh actually shows, and because the two
    sources disagree: seen on 15.9.2026 with sysfs saying "Charging" at
    0.6 W while UPower said "discharging" at 0 W and the shell drew the
    plain icon. Which icon is on screen decides whether there are two
    halves to colour, so it has to come from the same place as the icon.
    """
    # One test seam, like the settings file: the tests must not depend on
    # what this phone's UPower happens to say while they run.
    forced = os.environ.get("FURIOS_BATTERY_ICON")
    if forced is not None:
        return forced or None
    try:
        out = subprocess.run(["upower", "-i", UPOWER_DEV],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.stdout.splitlines():
        if "icon-name" in line:
            return line.split(":", 1)[1].strip().strip("'")
    return None


def icon_says_charging(name):
    """Does the icon on screen carry the bolt?"""
    return "-charging" in (name or "")


def sources_agree(reading, icon=None):
    """Do the kernel and UPower tell the same story?

    They do not always. On 15.9.2026 sysfs said "Charging" at 1.8 W while
    UPower said "discharging" at 0 W, and phosh - which follows UPower -
    drew the icon without a bolt. Painting a charging colour onto an icon
    that says the phone is on battery is worse than painting nothing: the
    colour would be answering a question the picture does not ask.

    So when they disagree, the shell gets no colour at all. The filling
    still does - how full the battery is, both sources agree on.
    """
    if reading is None or icon is None:
        return True
    return icon_says_charging(icon) == bool(reading["charging"])


def merge_colours(power, level):
    """One colour for an icon that has only one shape: the more urgent of
    the two. Neither statement is dropped silently - what is left is "there
    is something worth noticing", which is what a single shape can say."""
    return power if RANK[power] >= RANK[level] else level


# A plausibility ceiling, not a limit. current_now × voltage_now is the whole
# measurement, and a driver that reports milliamps where the class says
# microamps would produce a thousandfold number and a permanently green icon.
# Better to say nothing than to say something wrong.
MAX_PLAUSIBLE_W = 60.0
# The same idea for a time, and it is deliberately tight. This battery holds
# 4.37 Ah; the weakest source that is still charging is a 500 mA port, which
# is a full charge in nine hours, and a phone that never suspends empties a
# full battery in about eleven. So anything beyond a day is not a time to
# full or a time to empty - it is a cable that has fallen out of a broken
# socket, measured on 16.9.2026 at 0.065 A and "33 hours". The bar says the
# percentage instead, which is the one thing that is still true.
MAX_PLAUSIBLE_H = 24.0


def upower_hours(time_to_full, time_to_empty, charging):
    """UPower's own estimate for the direction we are going, in hours.

    Preferred over our arithmetic, because UPower keeps a history of this
    battery and we keep five minutes of it. Measured on 16.9.2026 against a
    socket that was dropping out: UPower said 3:03 while the same instant of
    current_now, divided into the missing charge, said 51:36.

    It is free: the daemon is subscribed to this device for its clock
    already, so both numbers arrive cached with the signal that wakes us.

    Zero is UPower's way of saying it does not know - at startup, and for
    whichever direction the battery is not going. Then, and only then, the
    arithmetic below answers instead.
    """
    seconds = time_to_full if charging else time_to_empty
    if not seconds or seconds <= 0:
        return None
    hours = seconds / 3600.0
    return hours if 0 < hours <= MAX_PLAUSIBLE_H else None


def cached_int(proxy, name):
    """One of UPower's cached int64 properties, or 0.

    Cached: no call and no round trip, because the value came along with the
    signal that woke the daemon. Zero for anything unexpected - 0 is already
    UPower's own word for "no answer", so there is nothing to invent.
    """
    try:
        value = proxy.get_cached_property(name)
        return value.get_int64() if value else 0
    except (AttributeError, TypeError):
        return 0


def upower_seconds():
    """UPower's two estimates - (time to full, time to empty), in seconds.

    For the front ends. The daemon has a proxy of its own and reads the same
    two properties off it; this is the one-shot version, so that `battctl
    status` says what the bar says. The two disagreeing about the same
    battery is exactly the kind of trap this project keeps walking into.

    Over D-Bus rather than out of `upower -i`, which prints them humanised
    ("5.2 hours", "94.4 minutes") and would have to be parsed back into
    seconds - in whatever unit it picks next time.

    (0, 0) for everything that can go wrong: no bus, no UPower, no gi.
    """
    forced = os.environ.get("FURIOS_BATTERY_UPOWER_TIME")
    if forced is not None:
        try:
            voll, leer = (int(x) for x in forced.split(","))
            return voll, leer
        except ValueError:
            return 0, 0
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        proxy = Gio.DBusProxy.new_sync(
            bus, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None,
            "org.freedesktop.UPower", UPOWER_DEV,
            "org.freedesktop.UPower.Device", None)
    except Exception:                               # noqa: BLE001
        return 0, 0
    return cached_int(proxy, "TimeToFull"), cached_int(proxy, "TimeToEmpty")


def runtime_hours(reading, ampere=None):
    """How long the battery has left, in hours - or None.

    Discharging: what is in it over what is going out. Charging: what is
    missing over what is going in. Both from charge_counter and charge_full,
    in microampere-hours against amperes, so the micro cancels.

    None rather than a guess wherever a piece is missing - no reading, a
    cable in with nothing moving, a current of zero, a driver without the
    attributes. This is the one number somebody plans around, and a wrong
    time is worse than no time.
    """
    if reading is None or not reading.get("moving"):
        return None
    have, full = reading.get("charge_uah"), reading.get("charge_full_uah")
    if not have or not full:
        return None
    strom = reading.get("ampere") if ampere is None else ampere
    if not strom or strom <= 0:
        return None
    left = (full - have) if reading.get("charging") else have
    if left <= 0:
        return None
    hours = left / 1e6 / strom
    return hours if 0 < hours <= MAX_PLAUSIBLE_H else None


def strip_wanted(cfg):
    """Is the strip wanted at all?

    Either switch puts it up. The one that is off falls back to the
    percentage in the same place, so the bar does not rearrange itself when
    a cable goes in - which it would if the strip came and went with the
    direction, and every coming and going restyles all GTK3 apps.
    """
    return bool(cfg["runtime"] or cfg["charge_time"])


def time_wanted(reading, cfg):
    """Is a time wanted for what the battery is doing right now?

    Two switches, because they answer two questions. "How long does it last"
    is asked of a phone on battery; "how long until it is full" is asked of
    one on a cable, and somebody may well want one and not the other. What
    is not wanted falls back to the percentage rather than to nothing.
    """
    if reading is None or not reading.get("moving"):
        return False
    return bool(cfg["charge_time"] if reading.get("charging")
                else cfg["runtime"])


def format_runtime(hours):
    """Hours as a clock says them: 05:33. None stays None."""
    if hours is None:
        return None
    minutes = int(round(hours * 60))
    return "%02d:%02d" % (minutes // 60, minutes % 60)


def runtime_label(reading, text):
    """What goes where the percentage was.

    The time when it can be said, the percentage when it cannot. Never
    nothing: a blank spot where a number used to be reads as a fault, and a
    full battery or a cable that moves nothing are ordinary states. So the
    strip falls back to exactly what it replaced.
    """
    if text:
        return text
    percent = (reading or {}).get("percent")
    return "" if percent is None else "%d%%" % int(percent)


# --------------------------------------------------------------- Konfiguration

def load_config(path=None):
    """Defaults, overlaid with whatever is on disk.

    A broken or half-written file is not an error worth stopping for: the
    colour is cosmetic, the defaults are sane, and a daemon that refuses to
    start because a json file has a stray comma would be the bigger fault.
    """
    cfg = dict(DEFAULTS)
    try:
        with open(path or CONFIG) as fh:
            read_back = json.load(fh)
        if isinstance(read_back, dict):
            for key, val in read_back.items():
                if key in DEFAULTS and isinstance(val, type(DEFAULTS[key])):
                    cfg[key] = val
                elif (key in DEFAULTS and isinstance(DEFAULTS[key], float)
                        and isinstance(val, int) and not isinstance(val, bool)):
                    # 3 where 3.0 was meant. json does not know the difference
                    # and a person editing the file by hand should not have to.
                    cfg[key] = float(val)
    except (OSError, ValueError):
        pass
    return cfg


def save_config(cfg, path=None):
    target = path or CONFIG
    os.makedirs(os.path.dirname(target), exist_ok=True)
    # Written beside the target and renamed: a phone that loses power halfway
    # through this should find the old file, not half of the new one.
    tmp = target + ".new"
    with open(tmp, "w") as fh:
        json.dump({k: cfg[k] for k in sorted(cfg)}, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, target)


def is_config_write(name, stamp, known):
    """Did this file event change the config, and is it the config at all?

    Two guards, because the daemon watches the DIRECTORY the config lives in
    and writes state.json into that same directory on every tick. Reacting to
    its own writes would be a loop with no end to it: write, wake, tick,
    write. So the name has to be the config's, and something in the file has
    to have actually moved - a rename onto an identical file is not a switch
    somebody threw.

    Its own function because the alternative lives in the main loop, where a
    compositor and a bus stand between a test and the decision.
    """
    return name == os.path.basename(CONFIG) and stamp != known


# ------------------------------------------------------------------- Messung

def _uah(name, base=None):
    """A charge in microampere-hours, or None.

    Zero is None here as well: an unpopulated attribute reads as 0 on this
    driver, and a battery holding nothing would divide into a runtime of
    nothing.
    """
    try:
        value = int(_read(name, base))
    except (TypeError, ValueError):
        return None
    return value if value > 0 else None


def _read(name, base=None):
    try:
        with open(os.path.join(base or SYSFS, name)) as fh:
            return fh.read().strip()
    except OSError:
        return None


def read_battery(base=None):
    """What the battery is doing right now, or None if it cannot be read.

    Sign is deliberately thrown away. Some drivers count discharge negative,
    some do not, and this one has only ever been seen charging - `status` is
    the reliable statement of direction, so the current is only ever asked how
    MUCH, never which way.
    """
    status = _read("status", base)
    current_ua = _read("current_now", base)
    voltage_uv = _read("voltage_now", base)
    if status is None or current_ua is None or voltage_uv is None:
        return None
    try:
        ampere = abs(int(current_ua)) / 1e6
        volt = int(voltage_uv) / 1e6
    except ValueError:
        return None
    try:
        # Missing or unreadable is None, not 0: a phone whose capacity
        # cannot be read must not have its icon painted "nearly empty".
        percent = float(_read("capacity", base))
    except (TypeError, ValueError):
        percent = None
    watt = ampere * volt
    # The gauge's own average, where the driver offers one. Same units, same
    # sign convention, and far steadier: measured on 16.9.2026 within one
    # second, current_now said 0.603 A and current_avg 0.378 A for the same
    # steady discharge.
    try:
        ampere_avg = abs(int(_read("current_avg", base))) / 1e6
    except (TypeError, ValueError):
        ampere_avg = None
    return {
        "status": status,
        "percent": percent,
        "ampere": ampere,
        "ampere_avg": ampere_avg,
        "volt": volt,
        "watt": watt,
        # What is in the battery and what fits in it, in microampere-hours.
        # charge_counter, not charge_now: this driver has no charge_now, and
        # charge_counter agrees with `capacity` to the percent (2 097 600 of
        # 4 370 000 = 48.0 %, read in the same second capacity said 48).
        # charge_full_design is NOT a substitute - this phone reports it a
        # factor of ten smaller than charge_full.
        "charge_uah": _uah("charge_counter", base),
        "charge_full_uah": _uah("charge_full", base),
        "charging": status == "Charging",
        # "Full" and "Not charging" are neither: the cable is in and nothing
        # is moving. Colouring that red would be a fault report for a phone
        # that is simply done.
        "moving": status in ("Charging", "Discharging"),
        "plausible": watt <= MAX_PLAUSIBLE_W,
    }


def median(values):
    s = sorted(values)
    n = len(s)
    if not n:
        return None
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def bucket_for(watt, charging, cfg, current=None):
    """Which of the three colours this wattage is, given the one showing now.

    `current` is what makes it hysteresis rather than a threshold: leaving a
    colour costs a tenth more than entering it did, so a reading that sits on
    a boundary and wobbles stays where it is.
    """
    h = cfg["hysteresis"]
    if charging:
        green_at, amber_at = cfg["charge_green_w"], cfg["charge_amber_w"]
        if current == "green":
            green_at *= 1 - h
        elif current == "amber":
            green_at *= 1 + h
            amber_at *= 1 - h
        elif current == "red":
            amber_at *= 1 + h
        if watt >= green_at:
            return "green"
        return "amber" if watt >= amber_at else "red"
    # On battery: white until the drain is unusual, then amber, then red.
    # No green - the ordinary case is the one that should say nothing.
    red_at, amber_at = cfg["drain_red_w"], cfg["drain_amber_w"]
    if current == "red":
        red_at *= 1 - h
    elif current == "amber":
        red_at *= 1 + h
        amber_at *= 1 - h
    else:
        amber_at *= 1 + h
    if watt >= red_at:
        return "red"
    return "amber" if watt >= amber_at else None


def level_for(percent, cfg, current=None):
    """The colour of the filling: how full, not how fast.

    None means "leave it in the panel's own colour" - which is what a
    healthy battery should look like, the same as every other icon up there.
    """
    if percent is None or not cfg["level"]:
        return None
    h = cfg["level_hysteresis_pct"]
    amber_at, red_at = cfg["level_amber_pct"], cfg["level_red_pct"]
    # Leaving a colour costs the two points that entering it did not, so a
    # percentage stepping across 60 and back does not restyle twice.
    if current == "red":
        red_at += h
    elif current == "amber":
        amber_at += h
        red_at -= h
    if percent < red_at:
        return "red"
    return "amber" if percent < amber_at else None


def wanted_level(reading, cfg, current=None):
    if reading is None:
        return None
    return level_for(reading.get("percent"), cfg, current)


def wanted_bucket(reading, cfg, current=None, icon=None):
    """The colour of the shell, or None for "leave it alone"."""
    if reading is None or not reading["plausible"] or not reading["moving"]:
        return None
    if not sources_agree(reading, icon):
        return None
    if reading["charging"] and not cfg["charging"]:
        return None
    if not reading["charging"] and not cfg["discharging"]:
        return None
    return bucket_for(reading["watt"], reading["charging"], cfg, current)


# -------------------------------------------------------------------- Themes

def base_name(name):
    """The user's own theme behind a name that may be one of ours."""
    treffer = MARK.match(name or "")
    return treffer.group("base") if treffer else name


def colours_of(name):
    """The pair (power, level) a theme name stands for, ("", "") if it is
    not one of ours. Either half may be None, meaning "not coloured"."""
    treffer = MARK.match(name or "")
    if not treffer:
        return ("", "")
    weiche = lambda value: None if value in (None, "none") else value  # noqa: E731
    return (weiche(treffer.group("power")), weiche(treffer.group("level")))


def theme_name(base, power=None, level=None, kind="d", percent=False):
    return "%s-batt%s-%s-%s-%s%s" % (base, TOKEN, power or "none",
                                     level or "none", kind,
                                     "-p" if percent else "")


def blanks_percentage(name):
    """Does this theme name stand for one that empties the percentage?"""
    treffer = MARK.match(name or "")
    return bool(treffer and treffer.group("percent"))


def base_css(base):
    """Where the user's theme keeps its GTK3 stylesheets.

    Returns (light, dark); dark is None when the theme has none. That case
    matters: GTK3 picks gtk-dark.css when it exists and the session prefers
    dark, so writing one for a theme that has none would make dark mode use
    the light stylesheet - the colour would work and the whole phone would
    change appearance.
    """
    for folder in THEME_DIRS:
        gtk3 = os.path.join(folder, base, "gtk-3.0")
        light = os.path.join(gtk3, "gtk.css")
        if os.path.isfile(light):
            dark = os.path.join(gtk3, "gtk-dark.css")
            return light, (dark if os.path.isfile(dark) else None)
    # Adwaita and HighContrast have no files: GTK3 carries them as resources.
    # Anything else with no stylesheet on disk is a theme we cannot build on,
    # and the caller says so rather than writing a theme that renders the
    # phone unstyled.
    eingebaut = {
        "Adwaita": ("Adwaita", "gtk-contained.css", "gtk-contained-dark.css"),
        "Adwaita-dark": ("Adwaita", "gtk-contained-dark.css", None),
        "HighContrast": ("HighContrast", "gtk-contained.css",
                         "gtk-contained-inverse.css"),
    }
    if base in eingebaut:
        folder, light, dark = eingebaut[base]
        path = "resource:///org/gtk/libgtk/theme/" + folder + "/"
        return path + light, (path + dark if dark else None)
    return None, None


def _import(target):
    # An @import keeps the original file the original file: everything it
    # loads by relative path - assets, the libadwaita part, the lot - still
    # resolves against where IT lives, not where our copy does.
    if target.startswith("resource:"):
        return '@import url("%s");\n' % target
    return '@import url("file://%s");\n' % target


def write_theme(base, power=None, level=None, kind="d", themes_dir=None,
                colors=None, percent=False):
    """Write the theme for one combination. Returns its name, or None.

    Written when it is needed rather than all twelve up front: most phones
    only ever see a handful of the combinations, and twelve directories in
    ~/.themes is twelve entries in every theme chooser on the phone.

    Rewritten every time even when it exists, because the user's theme may
    have been updated by a package - a stale copy of its name with a fresh
    stylesheet underneath is the kind of difference nobody would look for.
    """
    rule = css_rule(power, level, kind, colors, percent)
    if not rule:
        return None                       # nothing to say - that is the base
    light, dark = base_css(base)
    if light is None:
        return None
    root_dir = themes_dir or THEMES
    name = theme_name(base, power, level, kind, percent)
    gtk3 = os.path.join(root_dir, name, "gtk-3.0")
    os.makedirs(gtk3, exist_ok=True)
    header = ("/* Written by battctl (furios_misc). Deleted by "
            "`battctl restore`. */\n")
    with open(os.path.join(gtk3, "gtk.css"), "w") as fh:
        fh.write(_import(light) + header + rule)
    dark_target = os.path.join(gtk3, "gtk-dark.css")
    if dark:
        with open(dark_target, "w") as fh:
            fh.write(_import(dark) + header + rule)
    elif os.path.exists(dark_target):
        # The base theme lost its dark sheet between two runs.
        os.unlink(dark_target)
    return name


def can_theme(base):
    """Can anything be built on this theme at all?

    Asked before the daemon starts: a base with no GTK3 stylesheet is the
    one failure that leaves every other reading looking healthy while the
    icon never changes colour.
    """
    return base_css(base)[0] is not None


def stale_themes(themes_dir=None):
    """Our themes from an older rule. Returns the names."""
    root_dir = themes_dir or THEMES
    try:
        entries = sorted(os.listdir(root_dir))
    except OSError:
        return []
    old_paths = []
    for name in entries:
        if base_name(name) == name:
            continue                      # not one of ours
        if ("-batt%s-" % TOKEN) in name:
            continue                      # this generation
        old_paths.append(name)
    return old_paths


def remove_themes(themes_dir=None, only=None):
    """Take our themes off the disk. Returns how many went.

    `only` is a list of names - used to clear out what an older version of
    the rule left behind without touching this generation, so a phone does
    not collect directories per upgrade.
    """
    root_dir = themes_dir or THEMES
    gone = 0
    try:
        entries = sorted(os.listdir(root_dir))
    except OSError:
        return 0
    for name in entries:
        if only is not None and name not in only:
            continue
        if base_name(name) == name:
            continue                      # not one of ours
        path = os.path.join(root_dir, name)
        marker = os.path.join(path, "gtk-3.0", "gtk.css")
        try:
            with open(marker) as fh:
                if "battctl" not in fh.read(200):
                    continue              # same name, somebody else's file
        except OSError:
            continue
        for folder, _, files in os.walk(path, topdown=False):
            for file_ in files:
                os.unlink(os.path.join(folder, file_))
            os.rmdir(folder)
        gone += 1
    return gone


# ----------------------------------------------------------- the setting itself

class Setting:
    """The gtk-theme key, through `gsettings`.

    The command line rather than Gio.Settings on purpose: this has to work
    from a test and from a terminal over ssh, and a schema object bound to a
    session bus does neither without ceremony. One process per change, and
    changes are rare by design.
    """

    def __init__(self, file_=None, schluessel=SETTING, umgebung=None):
        # Tests point this at a file instead of dconf. Nothing else does.
        self.schluessel = schluessel
        self.file_ = file_ or os.environ.get(
            umgebung or "FURIOS_BATTERY_SETTING_FILE")

    def get(self):
        if self.file_:
            try:
                with open(self.file_) as fh:
                    return fh.read().strip()
            except OSError:
                return ""
        try:
            out = subprocess.run(["gsettings", "get"] + self.schluessel.split(),
                                 capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            return ""
        return out.stdout.strip().strip("'")

    def set(self, name):
        if self.file_:
            with open(self.file_, "w") as fh:
                fh.write(name + "\n")
            return True
        try:
            out = subprocess.run(["gsettings", "set"]
                                 + self.schluessel.split() + [name],
                                 capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            return False
        return out.returncode == 0


def icon_setting():
    """The icon-theme key. Its own file in the tests, like the other one."""
    return Setting(schluessel=ICON_SETTING,
                   umgebung="FURIOS_BATTERY_ICON_SETTING_FILE")


def percent_setting():
    """The key that shows the percentage beside the icon.

    Through `gsettings` and not through Gio even in the daemon, unlike the
    theme: this one is written twice in the life of a daemon - once when the
    strip goes up, once when it comes down - so a process per change costs
    nothing and keeps one class for all three keys.
    """
    return Setting(schluessel=PERCENT_SETTING,
                   umgebung="FURIOS_BATTERY_PERCENT_SETTING_FILE")


def load_state(path=None):
    """What we remember across runs. Broken file reads as nothing known."""
    try:
        with open(path or STATE) as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def save_state(state, path=None):
    """What we remember, written for this user alone.

    0600 rather than whatever the umask says. It is one line about one
    setting, but the umask on this phone is 002 and a sibling project had
    exactly this kind of file group-writable - a second account could decide
    what the shell looked like. Cheap to get right, awkward to notice.
    """
    target = path or STATE
    os.makedirs(os.path.dirname(target), exist_ok=True)
    tmp = target + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(state, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, target)


def claim_percentage_space(setting=None, state_path=None):
    """Make sure phosh keeps reserving the percentage's place - and write
    down what the setting was first.

    Not "hide it": the time goes exactly where the percentage was, and that
    place only exists while phosh is still laying the percentage out. So the
    key has to be ON, and the text is emptied by the theme instead.

    Remembered rather than assumed: somebody who had the percentage switched
    off must not be left with it on afterwards because of us. Written once,
    so a daemon restarted while the strip is up does not overwrite the real
    answer with our own "true".
    """
    setting = setting or percent_setting()
    was = setting.get()
    if was in ("true", "false"):
        state = load_state(state_path)
        if "percent_was" not in state:
            state["percent_was"] = was
            save_state(state, state_path)
    return True if was == "true" else setting.set("true")


def percentage_switched_off(setting=None):
    """Has somebody switched the percentage off while we hold the place?

    Asked on every tick, because the answer can change without us: the
    switch is in phosh-mobile-settings under Top Bar and it is the same key.
    Off means phosh stops laying the percentage out, the battery icon moves
    into the freed space, and the place our clock stands in is gone - so
    that is the moment to stand down rather than draw over an icon.
    """
    return (setting or percent_setting()).get() == "false"


def strip_action(option_on, strip_up, percentage_off, yielded):
    """What the strip does this tick. One of:

      "up"    build it and hide the percentage
      "hold"  it is up and right - just write the time into it
      "down"  take it away and give the percentage back
      "yield" the same, but because somebody switched the percentage off
              and took the place our clock stands in with it
      "wait"  the option is on and we have yielded to that decision
      "reset" the option went off while we were standing down - forget it,
              so switching it on again is a fresh start rather than a
              switch that does nothing for ever
      "idle"  nothing to do

    Its own function because the interesting case is a three-way one and it
    lives in the daemon's main loop otherwise, where GTK and a compositor
    stand between a test and the decision. The rule it encodes: the place
    our clock stands in belongs to phosh's percentage, so whoever switches
    that off has taken it, and we stand down - once, not once a tick.
    """
    if not option_on:
        if strip_up:
            return "down"
        return "reset" if yielded else "idle"
    if strip_up:
        return "yield" if percentage_off else "hold"
    return "wait" if yielded else "up"


def release_percentage_space(setting=None, state_path=None):
    """Put the setting back the way it was found, once, and forget it.

    Idempotent, because it is called from three places that may all happen:
    the daemon on SIGTERM, `battctl reset` from ExecStopPost after a kill -9,
    and `battctl restore` from the app. Nothing known means nothing to undo -
    a phone whose setting we never touched is not ours to change.
    """
    state = load_state(state_path)
    was = state.pop("percent_was", None)
    if was is None:
        return True
    setting = setting or percent_setting()
    # Only what we switched on. If it is off again, somebody did that
    # themselves and that decision outranks the one we wrote down.
    ok = setting.get() != "true" or setting.set(was)
    save_state(state, state_path)
    return ok


def use_icon_theme(setting=None, root_dir=None, source=None):
    """Write our icon theme and switch to it. Returns True if it is in use.

    The switch is what makes GTK re-read: it caches lookups and does not
    notice a file appearing under a theme it is already using.
    """
    setting = setting or icon_setting()
    current = setting.get()
    base = (icon_base_theme(root_dir) if ICON_ANY.match(current or "")
            else current)
    if not write_icon_theme(base or "Adwaita", root_dir, source):
        return False
    if current != ICON_THEME:
        return setting.set(ICON_THEME)
    return True


def drop_icon_theme(setting=None, root_dir=None):
    """Back to the user's own icon theme, then take ours away.

    In that order, and not the other way round: a theme whose files vanish
    under a shell that has them cached leaves a broken-image placeholder in
    the bar with no way back short of restarting phosh.
    """
    setting = setting or icon_setting()
    base = icon_base_theme(root_dir) or "Adwaita"
    if ICON_ANY.match(setting.get() or ""):
        setting.set(base)
    return remove_icon_theme(root_dir)


# ---------------------------------------------------------------------- state

def describe(cfg=None, setting=None, base=None):
    """Everything both front ends show, in one dict."""
    cfg = cfg or load_config()
    setting = setting or Setting()
    reading = read_battery()
    current = setting.get()
    base = base or base_name(current)
    zeigt, zeigt_stand = colours_of(current)
    stand = wanted_level(reading, cfg, zeigt_stand)
    # Two names: the one UPower publishes, which is what the direction
    # comes from, and the one phosh actually draws, which is the file that
    # decides whether there are two halves.
    reported = upower_icon()
    agree = sources_agree(reading, reported)
    icon = phosh_icon((reading or {}).get("percent"),
                        (reading or {}).get("charging"))
    bucket = wanted_bucket(reading, cfg, zeigt, icon)
    split = icon_is_split(icon, (reading or {}).get("charging"))
    on_bolt = bool((reading or {}).get("charging")) and icon_has_bolt(icon)
    del reported
    if not split:
        bucket = stand = merge_colours(bucket, stand)
    light, _ = base_css(base)
    return {
        "state": (reading or {}).get("status", "unknown"),
        "watt": round((reading or {}).get("watt", 0.0), 2),
        "ampere": round((reading or {}).get("ampere", 0.0), 3),
        "volt": round((reading or {}).get("volt", 0.0), 3),
        "percent": (reading or {}).get("percent"),
        # The same two sources in the same order as the bar: UPower's
        # estimate, and our own arithmetic only where UPower has no answer.
        # Not the same smoothing, though - this is ONE reading, while the bar
        # shows the median of five minutes of them, so the two differ by
        # however much the battery is swinging. Asking sysfs alone would be
        # worse: a status line that disagrees with the bar it is meant to
        # explain, and by hours rather than by minutes.
        "runtime": (format_runtime(upower_hours(*upower_seconds(),
                                                 charging=(reading or {})
                                                 .get("charging"))
                                   or runtime_hours(reading))
                    if time_wanted(reading, cfg) else None),
        "readable": reading is not None,
        "plausible": (reading or {}).get("plausible", False),
        "bucket": bucket or "none",
        "showing": zeigt or "none",
        # The filling, which says something else: how full, not how fast.
        "level_bucket": stand or "none",
        "level_showing": zeigt_stand or "none",
        # Whether this icon has two halves to colour at all.
        "icon": icon or "?",
        "split_icon": split,
        # Which shape the power colour lands on.
        "power_on": "bolt" if on_bolt else "frame",
        # False while the kernel and UPower disagree about the direction.
        "sources_agree": agree,
        "theme": current,
        "base_theme": base,
        # A theme we cannot build on is the one failure that leaves everything
        # else looking healthy, so it is stated rather than implied.
        "can_theme": light is not None,
        "config": cfg,
    }


def cmd_status(argv):
    state = describe()
    if "--json" in argv:
        print(json.dumps(state, indent=2, sort_keys=True))
        return 0 if state["readable"] else 1
    cfg = state["config"]
    print("state:        %s" % state["state"])
    if state["readable"]:
        print("power:        %.2f W (%.3f A at %.3f V)"
              % (state["watt"], state["ampere"], state["volt"]))
    else:
        print("power:        not readable (%s)" % SYSFS)
    print("%-13s %s (would be %s)%s"
          % (state["power_on"] + ":", state["showing"], state["bucket"],
             "" if state["power_on"] == "bolt"
             else " - the icon on screen has no bolt of its own"))
    print("filling:      %s (would be %s) at %s %%"
          % (state["level_showing"], state["level_bucket"],
             "?" if state["percent"] is None else int(state["percent"])))
    print("icon:         %s%s" % (state["icon"],
          "" if state["split_icon"]
          else " - one shape, so both halves take the same colour"))
    if not state["sources_agree"]:
        print("             ! the kernel says %s and UPower draws the other "
              "one - no colour for the shell until they agree"
              % state["state"].lower())
    print("base theme:   %s" % state["base_theme"])
    print("theme now:    %s" % state["theme"])
    if not state["can_theme"]:
        print("             ! no GTK3 stylesheet found for that theme - "
              "nothing can be coloured")
    print("charging:     %s (green from %.1f W, amber from %.1f W)"
          % ("on" if cfg["charging"] else "off",
             cfg["charge_green_w"], cfg["charge_amber_w"]))
    print("discharging:  %s (white below %.1f W, amber from there, red "
          "from %.1f W)"
          % ("on" if cfg["discharging"] else "off",
             cfg["drain_amber_w"], cfg["drain_red_w"]))
    print("filling:      %s (plain above %d %%, amber below, red below %d %%)"
          % ("on" if cfg["level"] else "off",
             int(cfg["level_amber_pct"]), int(cfg["level_red_pct"])))
    print("time left:    %s (on battery)" % ("on" if cfg["runtime"] else "off"))
    print("charge time:  %s (on a cable)" % ("on" if cfg["charge_time"] else "off"))
    print("would show:   %s"
          % (state["runtime"] or "the percentage - no time for this state"))
    return 0 if state["readable"] else 1


# Which config keys `battctl config` will take, and how to read the value.
SCHALTER = ("charging", "discharging", "level", "runtime", "charge_time")
ZAHLEN = ("charge_green_w", "charge_amber_w", "drain_amber_w", "drain_red_w",
          "level_amber_pct", "level_red_pct", "level_hysteresis_pct",
          "dwell_s", "window_s", "runtime_window_s", "hysteresis")


def cmd_config(argv):
    cfg = load_config()
    if not argv:
        for key in sorted(cfg):
            print("%s: %s" % (key, cfg[key]))
        return 0
    if len(argv) != 2:
        print("Usage: battctl config <key> <value>", file=sys.stderr)
        return 2
    key, value = argv
    key = key.replace("-", "_")
    if key in SCHALTER:
        if value not in ("on", "off"):
            print("%s takes on or off." % key, file=sys.stderr)
            return 2
        cfg[key] = value == "on"
    elif key in ZAHLEN:
        try:
            zahl = float(value)
        except ValueError:
            print("%s takes a number." % key, file=sys.stderr)
            return 2
        if zahl <= 0:
            print("%s must be greater than zero." % key, file=sys.stderr)
            return 2
        cfg[key] = int(zahl) if isinstance(DEFAULTS[key], int) else zahl
    else:
        print("Unknown setting: %s" % key, file=sys.stderr)
        print("Known: %s" % " ".join(sorted(SCHALTER + ZAHLEN)), file=sys.stderr)
        return 2
    # Thresholds that cross would make one colour unreachable, and the reason
    # would be two numbers in a file nobody opens.
    if cfg["charge_green_w"] <= cfg["charge_amber_w"]:
        print("charge_green_w must be above charge_amber_w.", file=sys.stderr)
        return 2
    if cfg["drain_amber_w"] >= cfg["drain_red_w"]:
        print("drain_amber_w must be below drain_red_w.", file=sys.stderr)
        return 2
    if cfg["level_red_pct"] >= cfg["level_amber_pct"]:
        print("level_red_pct must be below level_amber_pct.", file=sys.stderr)
        return 2
    save_config(cfg)
    print("%s: %s" % (key, cfg[key]))
    return 0


def cmd_reset(_argv):
    """Put the user's own theme back, and the percentage with it.

    Idempotent, and safe to call twice. This is what ExecStopPost runs, so
    it is also the answer to a kill -9: a phone left with no percentage by a
    daemon that is gone has lost a reading and been given nothing for it.
    """
    zurueck = release_percentage_space()
    setting = Setting()
    current = setting.get()
    base = base_name(current)
    if current != base and not setting.set(base):
        return 1
    return 0 if zurueck else 1


def cmd_restore(_argv):
    """Back to how the phone shipped: own theme, no colour themes, no config.

    The service is not stopped here - it is the app's switch and systemd's
    business, and a tool that disables the unit somebody just enabled would
    be fighting its own front end. The daemon notices the themes are gone and
    writes them again, which is why the app stops the service first.
    """
    # reset first: it is what puts the percentage back, and it has to read
    # the state file before that file goes.
    cmd_reset([])
    gone = remove_themes()
    icons = drop_icon_theme()
    for datei in (CONFIG, STATE):
        try:
            os.unlink(datei)
        except OSError:
            pass
    print("Own theme restored, %d colour theme(s) and %d icon copies removed."
          % (gone, icons))
    return 0


# --------------------------------------------------------------------- Daemon

class Daemon:
    """The loop: read, smooth, decide, and only then touch the setting."""

    def __init__(self, cfg=None, setting=None, current=None):
        self.cfg = cfg or load_config()
        self.setting = setting or Setting()
        self.samples = []                 # (when, watts, charging)
        # Its own, longer window, and amperes rather than watts: a time left
        # is a charge divided by a current, and the voltage in between would
        # only add its own noise.
        self.runtime_samples = []         # (when, amperes, charging)
        # UPower's estimate gets the same window, because it needs it just as
        # much: measured on 16.9.2026 on a steady discharge, six readings two
        # seconds apart said 11:08, 08:47, 10:11, 08:24, 10:34, 09:33. It has
        # the better history and it is still not a number to put in a bar
        # unsmoothed.
        self.upower_samples = []          # (when, hours, charging)
        # The last usable reading, kept for whoever draws the time. The tick
        # already has it; asking /sys a second time would be a second answer
        # to the same question.
        self.last_reading = None
        # (power, filling) - the names of the colours, not of the theme
        self.showing = (None, None)
        # Which shape the power colour is on, and which it should be on:
        # "c" the bolt of a charging icon, "d" the frame.
        self.kind_showing = "d"
        self.kind = "d"
        # Whether phosh's percentage should be emptied, and whether the theme
        # on screen actually does it. Two names, because between the two lies
        # a theme that may fail to be written - and the strip must not go up
        # over a percentage that is still readable.
        self.blank_percent = False
        self.blank_showing = False
        self.last_change = 0.0
        self.last_good = 0.0              # when something usable last arrived
        self.cfg_stamp = self._stamp()
        # The icon name UPower publishes, kept up to date by whoever drives
        # the loop. Used for ONE thing: telling whether UPower and the
        # kernel agree about the direction. Which file is drawn is a
        # different question, and phosh_icon() answers it - phosh builds
        # its own name and the two are not the same.
        self.icon = None
        # UPower's own two estimates, in seconds, kept up to date by whoever
        # drives the loop - 0 where it has no answer. Read from the same
        # cached properties as the icon, so they cost no call of their own.
        self.time_to_full = 0
        self.time_to_empty = 0
        self.base = base_name(current if current is not None else self.setting.get())

    @staticmethod
    def _stamp(path=None):
        try:
            state = os.stat(path or CONFIG)
        except OSError:
            return None
        return (state.st_mtime_ns, state.st_size)

    def reload(self):
        """Take a changed config without being restarted.

        The app switches "also on battery" by writing that file, and a daemon
        that only read it at startup would leave the switch looking broken
        until the next boot - the setting would be saved, and nothing would
        happen. Checked by timestamp, so the ordinary tick costs one stat().
        """
        stamp = self._stamp()
        if stamp == self.cfg_stamp:
            return False
        self.cfg_stamp = stamp
        self.cfg = load_config()
        return True

    def ensure_theme(self, power, level, kind="d"):
        """The theme for one combination, written if it is not there yet."""
        return write_theme(self.base, power, level, kind,
                           percent=bool(self.blank_percent))

    def adopt(self, name):
        """Somebody changed the theme while we were running.

        If it is not one of ours, it is a decision, and everything we generated
        is now built on the wrong base. Rebuild against the new one and carry
        the colour over.
        """
        if base_name(name) == self.base:
            return False
        self.base = base_name(name)
        self.showing = (None, None)
        # Their theme carries none of our rules, the emptied percentage
        # included - so it is on screen again until we write ours afresh.
        self.blank_showing = blanks_percentage(name)
        return True

    def sample(self, now=None, reading=None):
        now = time.time() if now is None else now
        reading = read_battery() if reading is None else reading
        if reading is None or not reading["plausible"]:
            return None
        self.samples.append((now, reading["watt"], reading["charging"]))
        grenze = now - self.cfg["window_s"]
        self.samples = [s for s in self.samples if s[0] >= grenze]
        # The gauge's average where the driver has one, the instantaneous
        # current where it has not.
        self.runtime_samples.append(
            (now, reading.get("ampere_avg") or reading["ampere"],
             reading["charging"]))
        grenze = now - self.cfg["runtime_window_s"]
        self.runtime_samples = [s for s in self.runtime_samples
                                if s[0] >= grenze]
        stunden = upower_hours(self.time_to_full, self.time_to_empty,
                               reading["charging"])
        if stunden is not None:
            self.upower_samples.append((now, stunden, reading["charging"]))
        self.upower_samples = [s for s in self.upower_samples
                               if s[0] >= grenze]
        return reading

    def decide(self, reading, now=None):
        """The colour to show, from the median of the window - not from the
        last reading. current_now swings by a quarter of an amp between two
        reads of the same steady charge."""
        now = time.time() if now is None else now
        if reading is None or not reading["moving"]:
            return None
        # A direction that keeps changing is not a direction. With a worn
        # USB port the phone flips between charging and discharging every
        # few minutes (measured on 15.9.2026: nine times in 26 minutes),
        # and following that would restyle every GTK3 app about once a
        # minute for something the cable is doing, not the battery. So the
        # shell says nothing until a whole window agrees.
        if len({c for (_, _, c) in self.samples}) > 1:
            return None
        same_way = [w for (_, w, c) in self.samples if c == reading["charging"]]
        middle = median(same_way) if same_way else reading["watt"]
        smoothed = dict(reading)
        smoothed["watt"] = middle
        return wanted_bucket(smoothed, self.cfg, self.showing[0], self.icon)

    def runtime(self, reading=None):
        """The time to show - UPower's estimate, or ours, or none at all.

        UPower first, because it has this battery's history and we have five
        minutes of it. It is also already on the line: the daemon rides its
        signal for a clock, so the estimate arrives cached with the wake-up
        and costs nothing to read. Through the same window as everything
        else, though - its estimate swings by a fifth between two readings
        two seconds apart, measured, and a bar is not the place for that.

        Ours is the fallback, for the minutes after a start when UPower
        answers 0 - charge over current, median of the same-direction samples
        in the window. Only the samples going the same way count: a cable
        pulled halfway through the window would otherwise average a charge
        current into a discharge and produce a time that was never true of
        either direction.

        Why smoothing at all: measured on 16.9.2026 in one second,
        current_now gave 0.603 A and current_avg 0.378 A on the same steady
        discharge - 03:29 against 05:33 for the same battery. The number
        replaces a percentage that moves once a minute, so it has to be at
        least that calm.

        None when the switch for this direction is off, and none when neither
        source can say - and then the strip shows the percentage, which is
        what it falls back to.
        """
        reading = self.last_reading if reading is None else reading
        if not time_wanted(reading, self.cfg):
            return None
        gemeldet = [h for (_, h, c) in self.upower_samples
                    if c == reading["charging"]]
        hours = median(gemeldet) if gemeldet else None
        if hours is None:
            gleich = [a for (_, a, c) in self.runtime_samples
                      if c == reading["charging"]]
            # One reading is enough to start from, but not to turn on.
            # Measured on 16.9.2026: a single stray Discharging reading
            # between two charging ones put 02:33 into a bar that said 01:27
            # before and after it - on this phone the socket does that by
            # itself, several times an hour. So a lone sample counts while
            # nothing has contradicted it, and stops counting the moment the
            # window also holds the other direction. At a start, where there
            # is one sample and nothing else at all, the bar still speaks.
            if len(gleich) < 2 and len(gleich) < len(self.runtime_samples):
                return None
            hours = runtime_hours(reading, median(gleich))
        return format_runtime(hours)

    def apply(self, pair, now=None, kind=None):
        """Set the theme for (power colour, filling colour).

        Returns True when the setting was written. One pair, one theme: the
        halves of the icon live in the same stylesheet, so a change to any
        of them is one switch, not two. `kind` says which shape the power
        colour lands on - the bolt of a charging icon, or the frame.
        """
        now = time.time() if now is None else now
        pair = tuple(pair)
        kind = self.kind if kind is None else kind
        blank = bool(self.blank_percent)
        if (pair == self.showing and kind == self.kind_showing
                and blank == self.blank_showing):
            return False
        # The dwell exists so a wobbling colour does not restyle every GTK3
        # app twice a minute. A change of the blanking is not a wobble, it is
        # somebody throwing a switch - and waiting 45 s for it would leave
        # the percentage and our clock in the bar side by side.
        if (self.showing != (None, None) and blank == self.blank_showing
                and now - self.last_change < self.cfg["dwell_s"]):
            return False
        if pair == (None, None) and not blank:
            target = self.base
        else:
            target = self.ensure_theme(pair[0], pair[1], kind)
            if target is None:
                return False
        if not self.setting.set(target):
            return False
        self.showing = pair
        self.kind_showing = kind
        self.blank_showing = blank
        self.last_change = now
        return True

    def tick(self, now=None, reading=None):
        now = time.time() if now is None else now
        self.reload()
        current = self.setting.get()
        if current and self.adopt(current):
            pass
        elif current and base_name(current) == self.base:
            # Someone (a crash of ours, a second instance) left a colour on
            # that we are not tracking. Adopt it so hysteresis and dwell start
            # from what is on screen.
            zeigt = colours_of(current)
            if zeigt != ("", "") and self.showing == (None, None):
                self.showing = zeigt
        measured = self.sample(now, reading)
        self.last_reading = measured
        if measured is None:
            # Nothing readable this time. One failed read is not a reason to
            # restyle every app on the phone, so the colour stays - but not
            # for ever: a colour nothing can justify any more is worse than
            # no colour, so once a whole window has gone by without a
            # measurement it goes.
            if (self.showing != (None, None)
                    and now - self.last_good > self.cfg["window_s"]):
                return self.apply((None, None), now)
            return False
        self.last_good = now
        shell = self.decide(measured, now)
        filling = wanted_level(measured, self.cfg, self.showing[1])
        drawn = phosh_icon(measured.get("percent"), measured["charging"])
        # Where the power colour goes: onto the bolt while charging, if the
        # icon on screen has one of its own; onto the frame otherwise.
        self.kind = "c" if (measured["charging"] and icon_has_bolt(drawn)) else "d"
        if not icon_is_split(drawn, measured["charging"]):
            # One shape, one colour. Saying both would mean the filling
            # silently overwriting the shell, or the other way round -
            # instead the more urgent of the two speaks for the whole icon.
            shell = filling = merge_colours(shell, filling)
        return self.apply((shell, filling), now, self.kind)


class RuntimeLabel:
    """The strip in the top bar where the percentage used to be.

    Layer-shell on OVERLAY, because phosh's own bar sits on TOP and draws
    over everything under it - a window on TOP maps, reports a size and
    cannot be seen. That is the finding killswitch-indicator is built on,
    and this reuses it rather than rediscovering it.

    It also reuses the trap that came with it. The input region is emptied
    from `draw` and from nowhere else: the strip is anchored left AND right,
    so it lies across the whole bar, and a strip that takes touch swallows
    the swipe to the quick settings - on the lock screen, the swipe that
    unlocks. Setting the region at realize time looks right in the source
    and never reaches the compositor.
    """

    # Logical px from the right edge to the end of our text, measured on the
    # device with grim rather than derived - the label carries trailing space
    # that no constant here can be read off.
    #
    # 15 puts the ink at 642..695 on this 720 px screen, i.e. 11 px clear of
    # the battery icon, where the percentage stood 13 px clear of it. It does
    # NOT end where the percentage ended (686): "05:45" is 53 px wide and
    # "49 %" was 43, so the gap to the icon and the right-hand padding cannot
    # both match. The gap is the one that shows - at 24, which lines the
    # right edges up, the clock touches the battery icon.
    RIGHT_MARGIN = 15
    BAR_HEIGHT = 32
    # phosh's own weight and figures, copied from its stylesheet rather than
    # guessed:
    #
    #   phosh-top-panel .indicators { font-size: 13px; font-weight: 800;
    #                                 font-feature-settings: "tnum"; }
    #
    # (gresource extract /usr/libexec/phosh /mobi/phosh/stylesheet/common.css)
    # 800, not bold - bold is 700 and sits visibly lighter beside the icons.
    # "tnum" is the one that matters most: with proportional digits a clock
    # changes width at every digit and shifts under itself once a minute. No
    # text shadow - phosh's indicators have none.
    #
    # The SIZE is ours, and deliberately not phosh's 13. A percentage is
    # glanced at; a time is read, and 13 px was too small to read at arm's
    # length on this screen. 16 is phosh's own clock size, so it is a size
    # that already exists in this bar rather than a new one.
    FONT_PX = 16
    CSS = b"""
#battery-runtime { background: transparent; }
#battery-runtime label {
    color: #ffffff;
    font-size: %dpx;
    font-weight: 800;
    font-feature-settings: "tnum";
}
"""

    @classmethod
    def start(cls):
        """The strip, or None and a line saying why.

        None and not an exception: this is the cosmetic half of a cosmetic
        daemon. A phone without gtk-layer-shell should still get its
        coloured icon, and should be told in one line what it is missing.
        """
        try:
            return cls()
        except Exception as error:                  # noqa: BLE001
            print("no strip in the top bar (%r) - the colour still works"
                  % (error,), file=sys.stderr, flush=True)
            return None

    def __init__(self):
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import Gtk, GtkLayerShell
        import cairo

        self.cairo = cairo
        self.text = None
        # False once the window is gone. A compositor that restarts takes
        # every layer surface with it, and without this the daemon would go
        # on holding a dead window - a bar with nothing in it and an emptied
        # percentage behind it, until something else rebuilt the strip.
        self.alive = True
        # Whether the compositor has been told this strip takes no touch.
        # False until a draw has actually pushed it - see on_draw.
        self.input_region_set = False

        self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.win.set_app_paintable(True)
        screen = self.win.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.win.set_visual(visual)

        GtkLayerShell.init_for_window(self.win)
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT,
                     GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self.win, edge, True)
        # -1: take no space of our own and do not get pushed below the bar
        # that already takes some.
        GtkLayerShell.set_exclusive_zone(self.win, -1)
        GtkLayerShell.set_namespace(self.win, "furios-battery-runtime")

        self.label = Gtk.Label(label="")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        box.set_name("battery-runtime")
        box.set_halign(Gtk.Align.END)
        box.set_valign(Gtk.Align.CENTER)
        box.set_margin_end(self.RIGHT_MARGIN)
        box.pack_start(self.label, False, False, 0)
        self.win.set_size_request(-1, self.BAR_HEIGHT)
        self.win.add(box)

        provider = Gtk.CssProvider()
        provider.load_from_data(self.CSS % self.FONT_PX)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win.connect("draw", self.on_draw)
        self.win.connect("map-event", self.on_map_event)
        self.win.connect("size-allocate", self.on_size_allocate)
        self.win.connect("destroy", self.on_destroy)
        self.win.show_all()

    def on_draw(self, _widget, _cr):
        """Let every touch through: an empty input region, from here.

        Not from `realize`. Traced on the device in the sibling project: the
        surface a region is set on at realize time is not the one the window
        ends up with, and GDK pushes a region to the compositor only while it
        paints. Set anywhere else the call sits in a field nobody sends, and
        the strip silently keeps taking touch across the whole bar.
        """
        if not self.input_region_set:
            gdk_window = self.win.get_window()
            if gdk_window is not None:
                gdk_window.input_shape_combine_region(self.cairo.Region(), 0, 0)
                self.input_region_set = True
        return False

    def on_map_event(self, _widget, _event):
        """A new surface carries no region of ours; the next draw sets it."""
        self.input_region_set = False
        return False

    def on_size_allocate(self, _widget, _allocation):
        """The strip changes width with the text. Empty either way, but it
        costs one commit to be sure of it."""
        self.input_region_set = False

    def on_destroy(self, *_):
        self.alive = False

    def set(self, text):
        """The text, written only when it changed."""
        if text == self.text:
            return False
        self.text = text
        self.label.set_text(text)
        return True

    def close(self):
        self.alive = False
        self.win.destroy()


def cmd_daemon(_argv):
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    class GioSetting(Setting):
        """The same key, read and written inside this process.

        The command line is right for a one-shot; for the daemon it is a
        fork, an exec and a schema parse per tick, which measured 47 ms a
        minute - not much, and all of it for a value we can hold. Same
        class, so everything above it is unchanged.
        """

        def __init__(self):
            super().__init__()
            self.file_ = None
            schema, schluessel = SETTING.split()
            self.gio = Gio.Settings.new(schema)
            self.schluessel = schluessel

        def get(self):
            return self.gio.get_string(self.schluessel)

        def set(self, name):
            gesetzt = self.gio.set_string(self.schluessel, name)
            # Written through before we call it done: the process may be
            # asked to stop in the next moment, and a theme that only
            # reaches dconf after we are gone is a theme nobody set.
            Gio.Settings.sync()
            return gesetzt

    # GTK has to be up before a window of ours can be, and it has to be up
    # in this process: the strip shares this main loop. init_check rather
    # than init, because a daemon started without a display should go on
    # colouring rather than abort.
    strip = None
    # Set once the percentage has been switched off by hand while our strip
    # was up. It stops the next tick from claiming the place again.
    yielded = False
    # Whether a lock screen is over us. Asked once at startup and kept up to
    # date by logind - a daemon restarted while the phone is locked would
    # otherwise empty a percentage that is the only thing on the lock screen.
    locked = False
    try:
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
        Gtk.init_check([])
    except (ValueError, ImportError) as error:
        print("no GTK here (%s) - the time left cannot be drawn" % error,
              file=sys.stderr, flush=True)

    class GioFlag(Setting):
        """The percentage key, read inside this process.

        Same class and the same "true"/"false" strings, so everything built
        on Setting is unchanged - but no fork per reading. Measured before
        this existed: the daemon spent 0.29 s of every 60 in child
        processes, two thirds of all the CPU it used, for one `gsettings
        get` on every tick. The theme key had been given this treatment for
        the same reason; the new key went in through the front door and
        undid it.
        """

        def __init__(self):
            super().__init__()
            self.file_ = None
            schema, schluessel = PERCENT_SETTING.split()
            self.gio = Gio.Settings.new(schema)
            self.schluessel = schluessel

        def get(self):
            return "true" if self.gio.get_boolean(self.schluessel) else "false"

        def set(self, value):
            gesetzt = self.gio.set_boolean(self.schluessel, value == "true")
            Gio.Settings.sync()
            return gesetzt

    prozent = GioFlag()
    daemon = Daemon(setting=GioSetting())
    # Leftovers from an older rule, before anything new is written: the
    # names differ, so nothing in use is touched.
    stale = stale_themes()
    if stale:
        remove_themes(only=stale)
    # Our copies of the discharge icons, so the filling can be coloured on
    # battery too. Identical to Adwaita's until something sets the palette,
    # and only in this user's icon directory.
    if daemon.cfg["level"]:
        for old in stale_icon_themes():
            remove_icon_theme(name=old)
        if use_icon_theme():
            print("icon theme %s in use - the discharge icons have a "
                  "filling of their own" % ICON_THEME, flush=True)
        else:
            print("could not build the icon theme - the filling cannot be "
                  "coloured on battery", file=sys.stderr, flush=True)
    if not can_theme(daemon.base):
        print("No GTK3 stylesheet found for theme %r - nothing to colour."
              % daemon.base, file=sys.stderr)
        return 1
    print("colouring the battery icon on top of %s" % daemon.base, flush=True)

    loop_ = GLib.MainLoop()
    proxy = None
    lockwatch = None

    def lock_state():
        """Whether a lock screen is over us, as logind has it.

        Free to ask: GDBusProxy keeps the property in step with logind's
        PropertiesChanged, so this is a local read and no bus traffic. That
        is why draw_time asks on every tick instead of trusting a signal it
        may have missed.
        """
        if lockwatch is None:
            return locked
        value = lockwatch.get_cached_property("LockedHint")
        return locked if value is None else value.get_boolean()

    def draw_time():
        """The strip follows the setting, in both directions.

        Built on the first tick that wants it rather than at startup: the
        app switches this on by writing the config, and a daemon that only
        looked once would leave the switch looking broken until the next
        boot. Taken down the same way, and the percentage comes back with
        it - the strip and the gap it fills are one decision.
        """
        nonlocal strip, yielded, locked
        locked = lock_state()
        # percentage_switched_off() only where the answer is used, so an
        # ordinary tick with no strip and no option costs no gsettings call.
        # The strip may be gone without us: a compositor that restarts takes
        # every layer surface with it, and a dead window that nobody notices
        # is a bar with nothing in it and an emptied percentage behind it.
        if strip is not None and not strip.alive:
            strip = None
        action = strip_action(
            strip_wanted(daemon.cfg), strip is not None,
            strip is not None and percentage_switched_off(prozent), yielded)
        if action == "up" and locked:
            # Nothing of ours can be seen behind a lock screen, so there is
            # nothing to take the percentage away for yet. It goes up when
            # the phone is unlocked.
            return

        if action == "reset":
            yielded = False
        elif action in ("down", "yield"):
            strip.close()
            strip = None
            daemon.blank_percent = False
            daemon.apply(daemon.showing, now=time.time() + daemon.cfg["dwell_s"])
            release_percentage_space(prozent)
            yielded = action == "yield"
            if action == "down":
                print("time left off, phosh's percentage back", flush=True)
            else:
                # The place our clock stands in is phosh's percentage slot.
                # Switched off in phosh-mobile-settings it is gone, the
                # battery icon moves into it, and drawing on would put the
                # time on top of the icon.
                print("the percentage was switched off by hand - the time "
                      "left stands down until this option is switched off "
                      "and on again", file=sys.stderr, flush=True)
        elif action == "up":
            # The place first, then the thing that stands in it. Both have
            # to succeed: a strip over a percentage that is still readable
            # would be two numbers in one spot.
            claim_percentage_space(prozent)
            daemon.blank_percent = True
            daemon.apply(daemon.showing, now=time.time() + daemon.cfg["dwell_s"])
            if not daemon.blank_showing:
                daemon.blank_percent = False
                release_percentage_space(prozent)
                print("the percentage could not be emptied (no usable GTK3 "
                      "theme) - no time in the bar", file=sys.stderr,
                      flush=True)
            else:
                strip = RuntimeLabel.start()
                if strip is None:
                    daemon.blank_percent = False
                    daemon.apply(daemon.showing,
                                 now=time.time() + daemon.cfg["dwell_s"])
                    release_percentage_space(prozent)
                else:
                    print("time left where the percentage was", flush=True)
        if strip is not None:
            # One place decides whether the percentage is emptied, and it is
            # this: emptied while the strip can be seen, back while it
            # cannot. Written here rather than in the handler that hears
            # about locking, so a tick in between puts it right as well.
            blank = not locked
            if daemon.blank_percent != blank:
                daemon.blank_percent = blank
                daemon.apply(daemon.showing,
                             now=time.time() + daemon.cfg["dwell_s"])
                print("locked - phosh's percentage is back" if locked
                      else "unlocked - the time has the place again",
                      flush=True)
            strip.set(runtime_label(daemon.last_reading, daemon.runtime()))

    def lock_changed(*_):
        """Locked or unlocked - and with it, who owns the percentage slot.

        Locked, the strip cannot be seen at all: phoc has no session-lock
        protocol, so the lock screen is an ordinary layer surface on the same
        OVERLAY layer, and within a layer the newest is on top - the lock
        screen is created when the phone is locked, i.e. after us. Measured
        with two strips side by side: the one started second covers the
        first.

        But the theme empties the percentage everywhere, the lock screen
        included, so leaving it emptied while the strip is hidden left the
        bar there with a battery icon and nothing beside it. Reported on
        16.9.2026.

        So the blanking is lifted for as long as the phone is locked and
        phosh shows its own percentage - the lock screen looks exactly as it
        did before this option existed.

        Why not the other way round, putting the strip back on top of the
        lock screen: rebuilding on the lock itself was measured and leaves no
        strip at all - locking turns the panel off in the same breath, and a
        layer surface created against an output that is off is never
        configured. The moment to do it is when the screen comes ON while
        locked. A strip built then DOES sit above the lock screen, measured
        on 16.9.2026 with a throw-away one - what was missing was a signal
        for that moment, and PowerSaveMode was not it: emitted on one lock
        and not on the next. LockedHint, below, would be.

        Nothing is decided here beyond the fact itself. draw_time reads the
        state itself, so an ordinary tick puts things right as well - this
        signal is how it happens at once, not the only way it can happen.
        """
        draw_time()

    def wake_up(*_):
        try:
            if proxy is not None:
                # Cached, so this costs nothing: the property arrives with
                # the signal that woke us.
                name = proxy.get_cached_property("IconName")
                daemon.icon = name.get_string() if name else None
                daemon.time_to_full = cached_int(proxy, "TimeToFull")
                daemon.time_to_empty = cached_int(proxy, "TimeToEmpty")
            geaendert = daemon.tick()
            # After the tick, so it draws this reading and not the one
            # before it; outside the `if`, because the time moves on every
            # reading while the colour moves on very few.
            draw_time()
            if geaendert:
                print("shell %s, filling %s -> %s"
                      % (daemon.showing[0] or "plain",
                         daemon.showing[1] or "plain",
                         daemon.setting.get()), flush=True)
        except Exception as error:                  # noqa: BLE001
            # A cosmetic daemon must not die of a surprise in one reading.
            print("tick failed: %r" % (error,), file=sys.stderr, flush=True)
        return True

    def shutdown(*_):
        # The theme goes back before we do. A green icon left behind on a
        # phone whose daemon is gone would be a lie that outlives it - and a
        # missing percentage with nothing in its place is the same thing
        # said by an absence.
        release_percentage_space()
        daemon.blank_percent = False
        daemon.apply((None, None), now=time.time() + daemon.cfg["dwell_s"])
        loop_.quit()
        return True

    # UPower is the clock. It already polls the battery for every other
    # program on the phone and emits a signal when a value moves, so riding
    # along costs no wake-ups of our own - and the alternative, a timer of
    # ours, is exactly the kind of thing that turned out to cost half a
    # percent of a core in a sibling project.
    #
    # The proxy is KEPT, not left to the garbage collector: a subscription
    # whose connection is dropped expires silently - no error, no log line, a
    # healthy-looking service that never measures anything. That has happened
    # here before.
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        proxy = Gio.DBusProxy.new_sync(
            bus, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None,
            "org.freedesktop.UPower",
            "/org/freedesktop/UPower/devices/battery_battery",
            "org.freedesktop.UPower.Device", None)
        proxy.connect("g-properties-changed", wake_up)
    except GLib.Error as error:
        print("no UPower to listen to (%s) - falling back to the timer alone"
              % error.message, file=sys.stderr, flush=True)
        proxy = None

    # Whether a lock screen is over us: logind's LockedHint on the graphical
    # session, because while the phone is locked the strip cannot be seen and
    # the percentage has to be given back for that time.
    #
    # NOT org.gnome.ScreenSaver, which this was built on and which answers a
    # different question. Measured on 16.9.2026 with the lock screen on the
    # display: `GetActive` said FALSE. phosh's own source says why - in
    # screen-saver-manager.c `active` follows the screen going blank, and the
    # screen is lit again the moment the phone is picked up, long before
    # anybody unlocks it. So the percentage stayed emptied on a lock screen
    # the strip cannot reach, and the bar showed a battery icon with nothing
    # beside it: exactly what lifting the blanking is for. What phosh does
    # publish on locking is logind's LockedHint (same file,
    # on_lockscreen_manager_locked_changed).
    #
    # The session is the DISPLAY session of this user, asked for by name
    # (`user/self` -> `Display`). Not the session this daemon runs in: that
    # is the systemd --user manager, class `manager`, whose LockedHint never
    # moves - reading that one is what hid this at first.
    #
    # Kept in a name of its own for the reason the UPower proxy is - a
    # subscription whose proxy is collected expires in silence, with no error
    # and no log line.
    try:
        system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        flags = (Gio.DBusProxyFlags.DO_NOT_AUTO_START |
                 Gio.DBusProxyFlags.GET_INVALIDATED_PROPERTIES)
        user = Gio.DBusProxy.new_sync(
            system, flags, None, "org.freedesktop.login1",
            "/org/freedesktop/login1/user/self",
            "org.freedesktop.login1.User", None)
        display = user.get_cached_property("Display")
        if display is None:
            raise GLib.Error("this user has no graphical session")
        lockwatch = Gio.DBusProxy.new_sync(
            system, flags, None, "org.freedesktop.login1",
            display.get_child_value(1).get_string(),
            "org.freedesktop.login1.Session", None)
        lockwatch.connect("g-properties-changed", lock_changed)
        locked = lock_state()
    except GLib.Error as error:
        print("no logind session to watch (%s) - the lock screen will show "
              "no percentage while the time is on" % error.message,
              file=sys.stderr, flush=True)
        lockwatch = None

    # The config file, so a switch thrown in the app is on screen at once.
    # Without this the only clocks are UPower's signal and the slow timer
    # below, and switching "time left" on took up to two minutes to show -
    # long enough that the switch looks broken and gets thrown again.
    #
    # The DIRECTORY, not the file: save_config writes beside the target and
    # renames, so the inode changes with every write and a monitor on the
    # file itself would follow the old one into nowhere.
    def config_written(_monitor, geaendert, _other, _event):
        try:
            if not is_config_write(geaendert.get_basename(),
                                   daemon._stamp(), daemon.cfg_stamp):
                return
            wake_up()
        except Exception as error:                  # noqa: BLE001
            print("config watch failed: %r" % (error,), file=sys.stderr,
                  flush=True)

    # Kept in a name, for the reason the two proxies above are: a monitor
    # nobody holds is collected, and what is left is a daemon that looks
    # healthy and never notices a thing.
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        ordner = Gio.File.new_for_path(os.path.dirname(CONFIG))
        config_monitor = ordner.monitor_directory(Gio.FileMonitorFlags.NONE,
                                                  None)
        config_monitor.connect("changed", config_written)
    except (GLib.Error, OSError) as error:
        print("cannot watch the config (%s) - a switch takes effect on the "
              "next reading instead of at once" % error, file=sys.stderr,
              flush=True)
        config_monitor = None

    # The safety net, and the whole answer when there is no UPower: a slow
    # timer. It also covers the case the comment above warns about - if the
    # subscription ever this_, the colour keeps following, just later.
    GLib.timeout_add_seconds(120, wake_up)
    # GLibUnix where it exists, GLib where it does not: pygobject moved
    # unix_signal_add and warns twice into the journal on every start
    # otherwise - two lines that would be in every log for ever, saying
    # nothing about this phone.
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError):
        signal_add = GLib.unix_signal_add
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, shutdown)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, shutdown)

    wake_up()
    loop_.run()
    # Referenced after the loop so nothing can decide the proxies were unused.
    del proxy, lockwatch
    return 0


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def quantil(values, fraction):
    if not values:
        return None
    s = sorted(values)
    # Round half UP, not round(): Python rounds 4.5 to 4, and a quantile
    # that quietly picks the lower neighbour at every .5 is a surprise in a
    # number somebody sets a threshold from.
    i = min(len(s) - 1, max(0, int(fraction * (len(s) - 1) + 0.5)))
    return s[i]


def cmd_watch(argv):
    """Write down what the phone actually draws, so the thresholds are
    measured rather than guessed.

    The number that matters is the drain with the SCREEN ON: this icon is
    only ever seen by somebody looking at the screen, so "normal" means
    normal while in use, not the 0.2 W of a phone lying on a table. The rows
    carry that state so the two can be told apart afterwards.
    """
    seconds, gap, target = 3600.0, 5.0, None
    rest = list(argv)
    while rest:
        wort = rest.pop(0)
        if wort in ("--csv", "-o") and rest:
            target = rest.pop(0)
        elif wort in ("--interval", "-i") and rest:
            gap = float(rest.pop(0))
        else:
            try:
                seconds = float(wort)
            except ValueError:
                print("Usage: battctl watch [seconds] [--interval s] "
                      "[--csv file]", file=sys.stderr)
                return 2

    out = open(target, "a") if target else None
    header = "time,state,watt,percent,screen"
    print(header, flush=True)
    if out and out.tell() == 0:
        out.write(header + "\n")

    samples = {"Charging": [], "Discharging": []}
    directions = []
    end_ = time.time() + seconds
    try:
        while time.time() < end_:
            reading = read_battery()
            if reading and reading["plausible"]:
                line = "%s,%s,%.3f,%s,%s" % (
                    now_iso(), reading["status"],
                    reading["watt"], _read("capacity") or "?", _screen_on())
                print(line, flush=True)
                if out:
                    out.write(line + "\n")
                    out.flush()
                samples.setdefault(reading["status"], []).append(reading["watt"])
                directions.append((now_iso(), reading["status"]))
            time.sleep(gap)
    except KeyboardInterrupt:
        print()
    finally:
        if out:
            out.close()

    # How often the direction changed during the run. A worn USB port
    # turns the charging half of a measurement into noise, and a calibration
    # run should say so rather than hand over a median of it.
    changes = 0
    before = None
    for when, state in directions:
        if before is not None and state != before:
            changes += 1
        before = state
    if changes:
        print("\ndirection changed %d times during the run - a charging "
              "figure from this is not a baseline" % changes)

    for state in ("Discharging", "Charging"):
        values = samples.get(state) or []
        if not values:
            continue
        print("\n%s: %d readings" % (state, len(values)))
        for name, fraction in (("median", 0.5), ("p90", 0.9), ("p98", 0.98)):
            print("  %-7s %5.2f W" % (name, quantil(values, fraction)))
        print("  %-7s %5.2f W" % ("max", max(values)))
        if state == "Discharging":
            print("  A starting point: amber at p90, red at p98 - so that "
                  "the ordinary tenth speaks and the rest stays white.")
    return 0


def read_log(path):
    """The rows of a `battctl watch` log. Returns (rows, error)."""
    try:
        with open(path) as fh:
            roh = fh.read().splitlines()
    except OSError as error:
        return [], str(error)
    rows = []
    for line in roh:
        parts = line.split(",")
        if len(parts) < 5 or parts[0] == "time":
            continue                      # Kopfzeile, oder abgeschnitten
        try:
            watt = float(parts[2])
        except ValueError:
            continue
        # Two shapes, because the column has had two: the panel's DPMS
        # state ("On"/"Off") and, on a device without that node, the
        # backlight number. Anything else is "do not know".
        roh_licht = parts[4].strip()
        if roh_licht in ("On", "Off"):
            licht = roh_licht == "On"
        else:
            try:
                licht = int(roh_licht) > 0
            except ValueError:
                licht = None
        rows.append({"time_": parts[0], "state": parts[1], "watt": watt,
                       "percent": parts[3], "screen": licht})
    if not rows:
        return [], "no readings in " + path
    return rows, None


def summarise(rows):
    """Quantiles per state, and for the discharge half split by screen.

    Split because only one of those halves decides the thresholds: this icon
    is seen only by somebody looking at the screen. The idle draw of a phone
    on a table is a different number and does not belong in the same
    distribution.
    """
    groups = {}
    for line in rows:
        schluessel = line["state"]
        groups.setdefault(schluessel, []).append(line["watt"])
        if line["state"] == "Discharging" and line["screen"] is not None:
            whither = ("Discharging, screen on" if line["screen"]
                     else "Discharging, screen off")
            groups.setdefault(whither, []).append(line["watt"])
    changes, before = 0, None
    for line in rows:
        if before is not None and line["state"] != before:
            changes += 1
        before = line["state"]
    return groups, changes


def suggestion(values):
    """Amber at p90, red at p98, to a tenth of a watt.

    So that the unusual tenth speaks and the rest stays plain. Returns
    None when the two would land on the same number - then there is not
    enough spread in the data to tell "unusual" from "ordinary".
    """
    if len(values) < 30:
        return None
    amber_at = round(quantil(values, 0.9), 1)
    red_at = round(quantil(values, 0.98), 1)
    if amber_at <= 0 or red_at <= amber_at:
        return None
    return amber_at, red_at


def cmd_summarise(argv):
    path, apply_it = None, False
    for wort in argv:
        if wort == "--apply":
            apply_it = True
        elif not wort.startswith("-") and path is None:
            path = wort
        else:
            print("Usage: battctl summarise <log.csv> [--apply]",
                  file=sys.stderr)
            return 2
    if path is None:
        print("Usage: battctl summarise <log.csv> [--apply]", file=sys.stderr)
        return 2

    rows, error = read_log(path)
    if error:
        print(error, file=sys.stderr)
        return 1
    groups, changes = summarise(rows)

    print("%d readings, %s to %s"
          % (len(rows), rows[0]["time_"], rows[-1]["time_"]))
    if changes:
        print("direction changed %d times - a charging figure from this is "
              "not a baseline" % changes)
    for name in sorted(groups):
        values = groups[name]
        print("\n%s: %d readings" % (name, len(values)))
        for wort, fraction in (("median", 0.5), ("p90", 0.9), ("p98", 0.98)):
            print("  %-7s %5.2f W" % (wort, quantil(values, fraction)))
        print("  %-7s %5.2f W" % ("max", max(values)))

    # The thresholds come from the screen-on half, and from nothing else.
    massgeblich = groups.get("Discharging, screen on") or []
    suggestion_ = suggestion(massgeblich)
    print()
    if suggestion_ is None:
        print("Not enough to set a threshold from: %d readings with the "
              "screen on. Use the phone on battery for a while and run the "
              "log again." % len(massgeblich))
        return 1
    amber_at, red_at = suggestion_
    print("Suggested: drain_amber_w %.1f (p90), drain_red_w %.1f (p98)"
          % (amber_at, red_at))
    if not apply_it:
        print("Apply with: battctl summarise %s --apply" % path)
        return 0
    cfg = load_config()
    cfg["drain_amber_w"], cfg["drain_red_w"] = amber_at, red_at
    save_config(cfg)
    print("Set. The daemon picks the file up on its own.")
    return 0


def _screen_on():
    """Whether the display is lit.

    The panel's DPMS state, which is a state and not a leftover value.
    Measured on 15.9.2026: the backlight LED keeps its last brightness
    after the screen goes dark (629 of 2047 with `grim` refusing to copy
    the output), and logind's IdleHint said "no" at the same moment. So
    those two can say "off" but cannot say "on", and this file can.

    Falls back to the backlight number where there is no DRM node, and to
    "?" where there is neither - a log column, not a verdict.
    """
    for path in ("/sys/class/drm/card0-DSI-1/dpms",
                 "/sys/class/drm/card0-eDP-1/dpms"):
        try:
            with open(path) as fh:
                return fh.read().strip()          # "On" / "Off"
        except OSError:
            continue
    for path in ("/sys/class/backlight/panel0-backlight/brightness",
                 "/sys/class/leds/lcd-backlight/brightness"):
        try:
            with open(path) as fh:
                return fh.read().strip()
        except OSError:
            continue
    return "?"


USAGE = """battctl - colour phosh's battery icon by charge power

  battctl status [--json]     what the battery is doing and which colour shows
  battctl config              every setting and its value
  battctl config <key> <val>  charging|discharging|level on|off for the
                              colours, runtime|charge_time on|off for the
                              time in the bar, or a threshold in W
  battctl watch [s] [--csv f] write down what the phone draws, to measure
                              the thresholds instead of guessing them
  battctl summarise <csv>     what a watch log says, and the thresholds it
                              suggests; --apply writes them
  battctl daemon              the loop; this is what the service runs
  battctl reset               put the user's own theme and percentage back
  battctl restore             reset, plus remove the colour themes and config

Everything is off after an install. `runtime` puts the time left where phosh
shows the percentage (on battery) and `charge_time` does the same on a cable;
whichever is off shows the percentage instead. The percentage keeps its place
and is emptied by the theme, so it comes back with `reset`, when the options
go off, and for as long as the phone is locked.

The service is what turns this on and off:
  systemctl --user enable --now furios-battery-color.service
"""


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    befehl, rest = argv[0], argv[1:]
    for name, fn in (("status", cmd_status), ("config", cmd_config),
                     ("daemon", cmd_daemon), ("reset", cmd_reset),
                     ("restore", cmd_restore), ("watch", cmd_watch),
                     ("summarise", cmd_summarise), ("summarize", cmd_summarise)):
        if befehl == name:
            return fn(rest)
    print("Unknown command: %s" % befehl, file=sys.stderr)
    print(USAGE, end="", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
